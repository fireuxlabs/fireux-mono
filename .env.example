# Monorepo Example Environment File
# Copy to individual app directories as needed (or export globally) and adjust per Firebase project.
# Lines with <REQUIRED> must be set; optional values can remain blank or be removed.
#
# IMPORTANT:
# - Values in this file are FIXED at init/runtime. They are NOT editable from the app UI.
# - App "brand" fields (avatar_url, wordmark_url, logo_url) are configured in Firestore,
#   but the underlying files MUST exist in /public/img/brand (or valid Storage URLs).
#   The env-check will validate presence & dimensions.

##############################
# Firebase Client Config
##############################
FIREBASE_API_KEY=<REQUIRED>
FIREBASE_AUTH_DOMAIN=<REQUIRED: your-project.firebaseapp.com>
FIREBASE_PROJECT_ID=<REQUIRED>
FIREBASE_STORAGE_BUCKET=<REQUIRED: your-project.appspot.com>
FIREBASE_MESSAGING_SENDER_ID=<REQUIRED: numeric>
FIREBASE_APP_ID=<REQUIRED: 1:...:web:...>
FIREBASE_MEASUREMENT_ID=            # (optional, only if using Analytics)
FIREBASE_RECAPTCHA_V3_KEY=          # (optional, if using App Check with ReCaptcha V3)

# Service account JSON path (server-side only). Either inline FIREBASE_SERVICE_ACCOUNT or point to file.
GOOGLE_APPLICATION_CREDENTIALS=./packages/tenants/<tenant>/config/service-account.json
FIREBASE_SERVICE_ACCOUNT=           # (optional JSON string override; prefer file path above)

##############################
# App Identity & Theming
##############################
APP_ID=<REQUIRED: unique-app-id>    # e.g. richies-reinigung
APP_NAME=FireUX
APP_SHORT_NAME=FireUX
APP_PRIMARY_COLOR="#0EA5E9"
APP_NEUTRAL_COLOR="#64748B"
APP_ICON=flame
ECOSYSTEM=<REQUIRED: fireux|misebox|cleanbox|...>

##############################
# Brand Assets (FILES, not env)
##############################
# Place tenant-specific assets under /public/img/brand and reference them from Firestore app.brand:
#   avatar_url:   /img/brand/avatar.png       (PNG, EXACTLY 512×512)
#   wordmark_url: /img/brand/wordmark.svg     (preferred) OR /img/brand/wordmark.png (PNG ≥ 256×64, aspect ≥ 3:1)
#   logo_url:     /img/brand/logo.svg         (preferred) OR /img/brand/logo.png     (PNG EXACTLY 512×512)
#
# Env-check will fail if:
# - files are missing/unreadable, or
# - PNG dimensions/aspect do not meet the rules above.
#
# NOTE:
# - Changing a logo/wordmark/avatar requires updating the file in /public/img/brand.
# - If you use Firebase Storage URLs instead, you must upload the new file to Storage and update the Firestore app.brand field.
# - These values are NOT user-editable from the UI.

##############################
# Deployment / Domain
##############################
APP_DOMAIN=example.app              # Authoritative domain (read-only from UI)
DOMAIN=http://localhost:3000        # Local dev URL

##############################
# Misc Project Settings
##############################
PROJECT_NAME=FireUX
AUTHOR_NAME=FireUX Team
PIN=1234                            # (if used for dev-only gating; remove in prod)

##############################
# OpenAI / External APIs
##############################
OPENAI_API_KEY_NAME=OPENAI_API_KEY
OPENAI_API_KEY=

##############################
# Stripe
##############################
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

##############################
# Developer Access / Feature Flags
##############################
DEVELOPER_ID=
DEV_MODE=true                       # (optional) consumed by runtime if implemented

##############################
# Optional PWA / Misc
##############################
# Add overrides consumed by createFireuxConfig({ pwa: {...} }) if needed
# PWA_THEME_COLOR=
# PWA_BACKGROUND_COLOR=

##############################
# Notes
##############################
# - Each app can have its own .env (gitignored) with different Firebase project credentials.
# - createFireuxConfig() reads these vars at build/start to populate runtimeConfig.public.firebaseConfig.
# - For CI, ensure all <REQUIRED> fields are injected securely (never commit real secrets here).
# - DO NOT place GitHub Personal Access Tokens here. Export them in your shell (e.g., `export GH_TOKEN=...`) or store as CI secrets.
