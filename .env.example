# FireUX canonical environment template
#
# This file is the single source of truth for environment variables expected by the repo.
# Copy to `.env` (repo root) or app-specific `.env` files as needed.

##############################
# App Identity & Theming
##############################
APP_ID=<REQUIRED: unique-app-id>
APP_NAME=<REQUIRED>
APP_SHORT_NAME=<REQUIRED>
APP_PRIMARY_COLOR=<REQUIRED>
APP_NEUTRAL_COLOR=<REQUIRED>
APP_SECONDARY_COLOR=
APP_ICON=<REQUIRED>
CENTRAL_SIGNUP_URL=
PIN=

ECOSYSTEM=<REQUIRED: fireux|misebox|cleanbox|...>

##############################
# Deployment / Domain
##############################
APP_DOMAIN=<REQUIRED>
DOMAIN=

##############################
# Nuxt / Nitro
##############################
NUXT_COMPATIBILITY_DATE=
NUXT_VITE_NODE_OPTIONS=
FIREUX_NITRO_PRESET=
NITRO_FIREBASE_REGION=
NITRO_ENV_EXPANSION=
NITRO_ENV_PREFIX=

##############################
# Firebase Client Config (public)
##############################
NUXT_FIREBASE_API_KEY=<REQUIRED>
NUXT_FIREBASE_AUTH_DOMAIN=<REQUIRED>
NUXT_FIREBASE_PROJECT_ID=<REQUIRED>
NUXT_FIREBASE_STORAGE_BUCKET=<REQUIRED>
NUXT_FIREBASE_MESSAGING_SENDER_ID=<REQUIRED>
NUXT_FIREBASE_APP_ID=<REQUIRED>
NUXT_FIREBASE_MEASUREMENT_ID=
NUXT_FIREBASE_RECAPTCHA_V3_KEY=

##############################
# Firebase Admin / Server Auth
##############################
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PRIVATE_KEY_ID=

FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

##############################
# Integrations
##############################
GOOGLE_PLACES_API_KEY=
OPENAI_API_KEY_NAME=OPENAI_API_KEY
OPENAI_API_KEY=

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

##############################
# Tooling / Scripts
##############################
FIREUX_REGISTRY_ENDPOINT=
ALLOW_INCOMPLETE_ENVS=
DISALLOW_APP_README=
FIREUX_DEBUG_LAYERS=
DEBUG=

##############################
# Runtime
##############################
NODE_ENV=
DEV_MODE=
DEVELOPER_ID=

##############################
# Notes
##############################
# - Do not commit real secrets. Use local `.env` or deployment secrets.