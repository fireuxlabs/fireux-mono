# Ignore all .firebase folders in any subdirectory
**/.firebase/**
# Node modules
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Firebase service accounts and secrets
**/service-account.json
**/*-service-account.json
**/*service-account*.json
service-account*.json

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Dummy data fixtures (local only)
temp/dummy-data/
temp/dummy-data/**
dummy/
dummy/**

# Coverage directory
coverage/
.nyc_output/

# Bower dependency directory
bower_components/

# Lock files
package-lock.json
yarn.lock

# Environment variables
.env
.env.*
!.env.*.template # allow the canonical templates while ignoring real env files
!templates/.env.app.template

# Build output
dist/
build/
.nuxt/
.data/
.output/
.cache/
.nitro/
**/*.js.map

# TypeScript build info
*.tsbuildinfo

# TypeScript artefacts (prevent JS/d.ts outputs in sources)
**/src/**/*.js
**/src/**/*.js.map
**/src/**/*.d.ts

# Editor configs and OS files
# VS Code: ignore all settings by default, allow only tasks/launch
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.DS_Store

# Backup and temporary files that can appear after crashes
*-new.*
*-backup.*
*New.*
*Backup.*
*.tmp
*.temp
*~

# Misc sensitive keys and certs
*.pem
*.key
*.crt
*.p12
*.der
*.mobileprovision

# Guardrails: ignore tenant-local type/placeholder files
packages/ecosystem/**/src/**/*.d.ts
packages/ecosystem/**/src/runtime/**/index.ts

# Migration backups (may contain PII and be very large)
migrations/backups/*.json
# Documentation artifacts
artifacts/

# AI work trees and chat outputs
AI/

# Mirror (disposable snapshots; safe to delete/recreate)
mirror/**
!mirror/README.md
