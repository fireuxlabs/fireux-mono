{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run FireUX Toolbar Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/tools/vscode-fireux-toolbar"
      ]
    },
    {
      "name": "Debug: bringli (3006)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm --dir 'projects/bringli/bringli-app' dev",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "Nitro server built|Nuxt Nitro server built",
        "action": "startDebugging",
        "name": "Browser: bringli",
        "killOnServerStop": true
      }
    },
    {
      "name": "Browser: bringli",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:3006",
      "webRoot": "${workspaceFolder}/projects/bringli/bringli-app",
      "sourceMaps": true,
      "presentation": {
        "group": "Browser sessions"
      }
    },
