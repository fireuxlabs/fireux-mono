{
  // Run & Debug targets backed by the tasks
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run FireUX Toolbar Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/tools/vscode-fireux-toolbar"
      ]
    },
    {
      "name": "Git Tree",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm git-tree",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "Dev Tools", "order": 1 }
    },
    {
      "name": "Git Tree (full)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm git-tree:full",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "Dev Tools", "order": 2 }
    },
    {
      "name": "🔥 FireUX dev (3000)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev:fireux",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "Dev Servers", "order": 1 }
    },
    {
      "name": "🥘 MiseBox dev (3001)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev:misebox",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "Dev Servers", "order": 2 }
    },
    {
      "name": "🧼 CleanBox dev (3002)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev:cleanbox",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "Dev Servers", "order": 3 }
    },
    {
      "name": "🦌 Niederhorn dev (3003)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev:niederhorn",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "Dev Servers", "order": 4 }
    },
    {
      "name": "🧽 Richies dev (3004)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev:richies",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "Dev Servers", "order": 5 }
    },
    {
      "name": "🏢 Tenant dev (3005)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev:tenant",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "Dev Servers", "order": 6 }
    }
  ],
  "compounds": [
    {
      "name": "All dev servers (3000+3001+3002)",
      "configurations": [
        "🔥 FireUX dev (3000)",
        "🥘 MiseBox dev (3001)",
        "🧼 CleanBox dev (3002)"
      ]
    },
    {
      "name": "All dev servers extended (3000-3005)",
      "configurations": [
        "🔥 FireUX dev (3000)",
        "🥘 MiseBox dev (3001)",
        "🧼 CleanBox dev (3002)",
        "🦌 Niederhorn dev (3003)",
        "🧽 Richies dev (3004)",
        "🏢 Tenant dev (3005)"
      ]
    }
  ]
}
