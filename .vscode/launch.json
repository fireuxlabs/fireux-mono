{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run FireUX Toolbar Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/tools/vscode-fireux-toolbar"
      ]
    },
    {
      "name": "Git Tree",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm git-tree",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "Dev Tools",
        "order": 1
      }
    },
    {
      "name": "Git Tree (full)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm git-tree:full",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "Dev Tools",
        "order": 2
      }
    },
    {
      "name": "FireUX dev (3000)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev:fireux",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "Dev Servers",
        "order": 1
      }
    },
    {
      "name": "Misebox dev (3001)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev:misebox",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "Dev Servers",
        "order": 2
      }
    },
    {
      "name": "Cleanbox dev (3002)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev:cleanbox",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "Dev Servers",
        "order": 3
      }
    },
    {
      "name": "Niederhorn dev (3003)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev:niederhorn",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "Dev Servers",
        "order": 4
      }
    },
    {
      "name": "Richies Reinigung dev (3004)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev:richies",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "Dev Servers",
        "order": 5
      }
    },
    {
      "name": "FireUX Tenant dev (3005)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev:tenant",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "Dev Servers",
        "order": 6
      }
    },
    {
      "name": "Bringli dev (3006)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev:bringli",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "Dev Servers",
        "order": 7
      }
    },
    {
      "name": "Find My SEO dev (3010)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev:find-my-seo",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "Dev Servers",
        "order": 8
      }
    },
    {
      "name": "Granite dev (3007)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev:granite",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "Dev Servers",
        "order": 9
      }
    },
    {
      "name": "La Tap Berne dev (3008)",
      "type": "node-terminal",
