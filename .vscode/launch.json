      "command": "pnpm dev:la-tap-berne",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "Dev Servers",
        "order": 10
      }
    }
  ],
  "compounds": [
    {
      "name": "All dev servers (3000+3001+3002)",
      "configurations": [
        "FireUX dev (3000)",
        "Misebox dev (3001)",
        "Cleanbox dev (3002)"
      ]
    },
    {
      "name": "All dev servers extended (3000-3005)",
      "configurations": [
        "FireUX dev (3000)",
        "Misebox dev (3001)",
        "Cleanbox dev (3002)",
        "Niederhorn dev (3003)",
        "Richies Reinigung dev (3004)",
        "FireUX Tenant dev (3005)"
      ]
    },
    {
      "name": "All dev servers full (3000-3010)",
      "configurations": [
        "FireUX dev (3000)",
        "Misebox dev (3001)",
        "Cleanbox dev (3002)",
        "Niederhorn dev (3003)",
        "Richies Reinigung dev (3004)",
        "FireUX Tenant dev (3005)",
        "Bringli dev (3006)",
        "Find My SEO dev (3010)",
        "Granite dev (3007)",
