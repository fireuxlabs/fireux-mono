{
  "name": "fireux",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "workspaces": [
    "packages/core/*",
    "packages/extensions/*",
    "packages/ecosystem/*",
    "packages/ecosystem/*/apps/*",
    "projects/*/*",
    "tools/*",
    "test-*"
  ],
  "scripts": {
    "dev:fireux": "node scripts/dev-app-with-smoke.mjs --app fireux",
    "dev:misebox": "node scripts/dev-app-with-smoke.mjs --app misebox",
    "dev:cleanbox": "node scripts/dev-app-with-smoke.mjs --app cleanbox",
    "dev:richies": "node scripts/dev-app-with-smoke.mjs --app richies",
    "dev:tenant": "node scripts/dev-app-with-smoke.mjs --app tenant",
    "dev:bringli": "node scripts/dev-app-with-smoke.mjs --app bringli",
    "dev:find-my-seo": "node scripts/dev-app-with-smoke.mjs --app find-my-seo",
    "dev:sproochli": "node scripts/dev-app-with-smoke.mjs --app sproochli",
    "dev:granite": "node scripts/dev-app-with-smoke.mjs --app granite",
    "dev:la-tap-berne": "node scripts/dev-app-with-smoke.mjs --app la-tap-berne",
    "dev:go-qr": "node scripts/dev-app-with-smoke.mjs --app go-qr",
    "dev:all": "node scripts/dev-app-group.mjs --group all",
    "dev:all-extended": "node scripts/dev-app-group.mjs --group all-extended",
    "dev:full": "node scripts/dev-app-group.mjs --group full",
    "smoke:app": "node scripts/smoke-app.mjs",
    "smoke:http": "node scripts/smoke-app.mjs --all",
    "smoke:components": "node scripts/smoke-component-resolution.mjs --app misebox",
    "smoke:prepare:app": "node scripts/smoke-prepare.mjs",
    "smoke:prepare": "node scripts/smoke-prepare.mjs --all",
    "create:ecosystem": "node scripts/create-ecosystem.mjs",
    "check": "node scripts/check.mjs",
    "build:all": "pnpm -r --parallel --filter './projects/*/*' build",
    "build:packages": "pnpm -r --filter './packages/*/*' build",
    "typecheck:apps": "pnpm -r --filter './projects/*/*' exec nuxi typecheck",
    "typecheck:packages": "pnpm -r --filter './packages/*/*' exec tsc --noEmit",
    "typecheck": "pnpm typecheck:packages && pnpm typecheck:apps",
    "lint": "eslint .",
    "lint:envs": "node scripts/lint-envs.mjs",
    "format": "prettier --write .",
    "guard": "node scripts/guard.mjs",
    "guard:slug": "node scripts/check-slug-canon.mjs",
    "guard:slug:report": "node scripts/check-slug-canon.mjs --report",
    "pre-guard-clean": "node scripts/pre-guard-clean.mjs",
    "guard:shape": "pnpm guard",
    "guard:ts": "pnpm tsc:check",
    "tsc:check": "pnpm typecheck:packages",
    "clean": "node scripts/clean.mjs",
    "clean:deep": "node scripts/clean.mjs --deep",
    "gitsave": "bash scripts/gitsave.sh",
    "go": "node scripts/go.mjs",
    "gen:cta-innards": "node scripts/generate-cta-innards.mjs",
    "gen:cta-trees": "node scripts/generate-cta-parent-trees.mjs",
    "audit:app-media": "node scripts/audit-app-media.mjs",
    "audit:usex": "node scripts/audit-usex-stack.mjs",
    "list:app-media-trash": "node scripts/list-app-media-trash.mjs",
    "delete:app-media-trash": "node scripts/delete-app-media-trash.mjs",
    "delete:app-media-folders": "node scripts/delete-app-media-folders.mjs",
    "sync:app-media-from-public": "node scripts/sync-app-media-from-public.mjs",
    "clear:app-fields": "node scripts/clear-app-firestore-fields.mjs",
    "git-tree": "node scripts/git-tree.mjs",
    "git-tree:full": "cross-env INCLUDE_CONTENT=1 node scripts/git-tree.mjs",
    "mirror:clear": "node scripts/mirror-clear.mjs",
    "mirror:sync": "node scripts/mirror-sync.mjs",
    "mirror:gitq": "node scripts/mirror-from-gitq.mjs",
    "mirror:models": "node scripts/mirror-models.mjs",
    "sync:dev-workspace": "node scripts/sync-dev-workspace.mjs",
    "seo:sitemap-counts": "node scripts/seo-sitemap-counts.mjs",
    "meta:report": "node scripts/page-meta-report.mjs",
    "reports:regenerate": "node scripts/reports/regenerate-reports.mjs",
    "sync:dev-workspace:check": "node scripts/sync-dev-workspace.mjs --check",
    "dev:buenohost": "node scripts/dev-app-with-smoke.mjs --app buenohost"
  },
  "engines": {
    "node": ">=20.11 <23",
    "pnpm": ">=10"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.2",
    "@iconify-json/logos": "^1.2.10",
    "@iconify-json/lucide": "^1.2.66",
    "@iconify-json/skill-icons": "^1.2.3",
    "@iconify-json/vscode-icons": "^1.2.37",
    "@internationalized/date": "^3.5.0",
    "@nuxt/eslint": "^1.12.1",
    "@nuxt/kit": "4.4.6",
    "@nuxt/schema": "4.4.6",
    "@nuxt/ui": "^4.0.0-alpha.2",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/parser": "^8.50.0",
    "@vueuse/core": "13.9.0",
    "browserslist": "^4.28.1",
    "caniuse-lite": "^1.0.30001779",
    "concurrently": "^9.2.0",
    "cross-env": "7.0.3",
    "eslint": "^9.39.4",
    "firebase": "11.10.0",
    "firebase-admin": "^12.7.0",
    "h3": "^1.15.4",
    "nuxt": "4.4.6",
    "prettier": "^3.0.0",
    "sass": "^1.96.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.2",
    "vite": "^6.0.0",
    "vue": "3.5.20",
    "vue-eslint-parser": "^10.2.0",
    "vue-router": "^4.5.0",
    "vue-tsc": "3.3.0",
    "vuefire": "3.2.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "nuxt": "4.4.6",
      "@nuxt/kit": "4.4.6",
      "@nuxt/schema": "4.4.6",
      "@nuxt/content": "3.6.3",
      "vue": "3.5.20",
      "firebase": "11.10.0",
      "vuefire": "3.2.2",
      "nuxt-vuefire": "^1.1.0"
    }
  },
  "packageManager": "pnpm@10.12.1",
  "dependencies": {
    "image-size": "^2.0.2",
    "qrcode": "^1.5.4"
  }
}
