{
  "name": "fireux",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "workspaces": [
    "packages/core/*",
    "packages/extensions/*",
    "packages/ecosystem/*",
    "projects/*/*",
    "tools/*",
    "test-*"
  ],
  "scripts": {
    "dev:fireux": "node scripts/free-port.mjs 3000 && pnpm --filter ./projects/fireux/fireux-app dev",
    "dev:misebox": "node scripts/free-port.mjs 3001 && pnpm --filter ./projects/misebox/misebox-app dev",
    "dev:cleanbox": "node scripts/free-port.mjs 3002 && pnpm --filter ./projects/cleanbox/cleanbox-app dev",
    "dev:niederhorn": "node scripts/free-port.mjs 3003 && pnpm --filter ./projects/misebox/niederhorn dev",
    "dev:richies": "node scripts/free-port.mjs 3004 && pnpm --filter ./projects/cleanbox/richies-reinigung dev",
    "dev:tenant": "node scripts/free-port.mjs 3005 && pnpm --filter ./projects/fireux/tenant dev",
    "dev:bringli": "node scripts/free-port.mjs 3006 && pnpm --filter ./projects/bringli/bringli-app dev",
    "dev:granite": "node scripts/free-port.mjs 3007 && pnpm --filter ./projects/granite/granite-app dev",
    "dev:la-tap-berne": "node scripts/free-port.mjs 3008 && pnpm --filter ./projects/misebox/la-tap-berne dev",
    "dev:all": "concurrently \"pnpm dev:fireux\" \"pnpm dev:misebox\" \"pnpm dev:cleanbox\"",
    "dev:all-extended": "concurrently \"pnpm dev:fireux\" \"pnpm dev:misebox\" \"pnpm dev:cleanbox\" \"pnpm dev:niederhorn\" \"pnpm dev:richies\" \"pnpm dev:tenant\"",
    "create:ecosystem": "node scripts/create-ecosystem.mjs",
    "build:all": "pnpm -r --parallel --filter './projects/*/*' build",
    "build:packages": "pnpm -r --filter './packages/*/*' build",
    "typecheck:apps": "pnpm -r --filter './projects/*/*' exec nuxi typecheck",
    "typecheck:packages": "pnpm -r --filter './packages/*/*' exec tsc --noEmit",
    "typecheck": "pnpm typecheck:packages && pnpm typecheck:apps",
    "lint": "eslint .",
    "lint:envs": "node scripts/lint-envs.mjs",
    "format": "prettier --write .",
    "guard": "node scripts/guard.mjs",
    "pre-guard-clean": "node scripts/pre-guard-clean.mjs",
    "guard:shape": "pnpm guard",
    "guard:ts": "pnpm tsc:check",
    "tsc:check": "pnpm typecheck:packages",
    "clean": "node scripts/clean.mjs",
    "clean:deep": "node scripts/clean.mjs --deep",
    "gitsave": "bash scripts/gitsave.sh",
    "go": "node scripts/go.mjs",
    "gen:cta-innards": "node scripts/generate-cta-innards.mjs",
    "gen:cta-trees": "node scripts/generate-cta-parent-trees.mjs",
    "audit:app-media": "node scripts/audit-app-media.mjs",
    "list:app-media-trash": "node scripts/list-app-media-trash.mjs",
    "delete:app-media-trash": "node scripts/delete-app-media-trash.mjs",
    "delete:app-media-folders": "node scripts/delete-app-media-folders.mjs",
    "sync:app-media-from-public": "node scripts/sync-app-media-from-public.mjs",
    "clear:app-fields": "node scripts/clear-app-firestore-fields.mjs",
    "git-tree": "node scripts/git-tree.mjs",
    "git-tree:full": "cross-env INCLUDE_CONTENT=1 node scripts/git-tree.mjs",
    "mirror:clear": "node scripts/mirror-clear.mjs",
    "mirror:sync": "node scripts/mirror-sync.mjs",
    "mirror:gitq": "node scripts/mirror-from-gitq.mjs",
    "seo:sitemap-counts": "node scripts/seo-sitemap-counts.mjs"
  },
  "engines": {
    "node": ">=20.11 <23",
    "pnpm": ">=10"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.2",
    "@iconify-json/logos": "^1.2.10",
    "@iconify-json/lucide": "^1.2.66",
    "@iconify-json/skill-icons": "^1.2.3",
    "@iconify-json/vscode-icons": "^1.2.37",
    "@internationalized/date": "^3.5.0",
    "@nuxt/eslint": "^1.12.1",
    "@nuxt/kit": "4.1.2",
    "@nuxt/schema": "4.1.2",
    "@nuxt/ui": "^4.0.0-alpha.2",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/parser": "^8.50.0",
    "@vueuse/core": "13.9.0",
    "concurrently": "^9.2.0",
    "cross-env": "7.0.3",
    "eslint": "^9.28.0",
    "firebase": "11.10.0",
    "firebase-admin": "^12.7.0",
    "h3": "^1.15.4",
    "nuxt": "4.1.2",
    "prettier": "^3.0.0",
    "sass": "^1.96.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.2",
    "vite": "^6.0.0",
    "vue": "3.5.20",
    "vue-eslint-parser": "^10.2.0",
    "vue-router": "^4.5.0",
    "vuefire": "3.2.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "nuxt": "4.1.2",
      "@nuxt/kit": "4.1.2",
      "@nuxt/schema": "4.1.2",
      "@nuxt/content": "3.6.3",
      "vue": "3.5.20",
      "firebase": "11.10.0",
      "vuefire": "3.2.2",
      "nuxt-vuefire": "^1.1.0"
    }
  },
  "packageManager": "pnpm@10.12.1",
  "dependencies": {
    "image-size": "^2.0.2",
    "qrcode": "^1.5.4"
  }
}
