{
  "name": "fireux-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/module.ts",
  "types": "./src/module.ts",
  "exports": {
    ".": "./src/module.ts",

    "./types/*": "./src/types/*.ts",
    "./config/app/*": {
      "types": "./src/config/app/*.ts",
      "development": "./src/config/app/*.ts",
      "production": "./dist/config/app/*.mjs",
      "default": "./dist/config/app/*.mjs"
    },
    "./config/app/runtime": {
      "types": "./src/config/app/runtime.ts",
      "development": "./src/config/app/runtime.ts",
      "production": "./dist/config/app/runtime.mjs",
      "default": "./dist/config/app/runtime.mjs"
    },
    "./config/module/*": {
      "types": "./src/config/module/*.ts",
      "development": "./src/config/module/*.ts",
      "production": "./dist/config/module/*.mjs",
      "default": "./dist/config/module/*.mjs"
    },
    "./runtime/*": "./src/runtime/*",

    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "types/*": ["src/types/*.ts"],
      "config/app/*": ["src/config/app/*.ts"],
      "config/app/runtime": ["src/config/app/runtime.ts"],
      "config/module/*": ["src/config/module/*.ts"],
      "runtime/*": ["src/runtime/*"]
    }
  },
  "files": ["src/**/*"],
  "scripts": {
    "build": "nuxt-module-build build",
    "dev": "nuxt-module-build --stub",
    "postbuild": "rimraf src/**/*.map",
    "clean": "rimraf dist"
  },
  "engines": {
    "node": ">=22.23 <23",
    "pnpm": "11.9.0"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.12.1",
    "firebase": "^11.10.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.2",
    "fireux-nuxtfire": "workspace:*",
    "google-auth-library": "^9.15.1",
    "h3": "^1.15.4",
    "image-size": "^2.0.2",
    "jiti": "^2.7.0",
    "tailwindcss": "^4.1.18",
    "vuefire": "^3.2.2"
  },
  "peerDependencies": {
    "@nuxt/kit": "^4.4.0",
    "@nuxt/schema": "^4.4.0",
    "@nuxt/ui": ">=3 <5",
    "@vueuse/core": "*",
    "nuxt": "^4.4.0",
    "sass": "^1.96.0",
    "vue": "^3.5.20",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@nuxt/kit": "^4.4.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.0",
    "@nuxt/ui": "^4.0.0-alpha.2",
    "rimraf": "^6.0.1",
    "sass": "^1.96.0",
    "vue": "^3.5.20",
    "vue-router": "^4.5.0"
  }
}
