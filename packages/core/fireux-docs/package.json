{
  "name": "fireux-docs",
  "version": "0.1.0",
  "description": "Passive FireUX docs layer",
  "private": true,
  "type": "module",
  "main": "./src/module.ts",
  "types": "./src/module.ts",
  "exports": {
    ".": "./src/module.ts",
    "./runtime/*.vue": {
      "types": "./src/runtime/*.vue",
      "default": "./src/runtime/*.vue"
    },
    "./runtime/*.css": {
      "types": "./src/runtime/*.css",
      "default": "./src/runtime/*.css"
    },
    "./runtime/*.scss": {
      "types": "./src/runtime/*.scss",
      "default": "./src/runtime/*.scss"
    },
    "./runtime/*": {
      "types": "./src/runtime/*.ts",
      "default": "./src/runtime/*.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "runtime/*.vue": [
        "src/runtime/*.vue"
      ],
      "runtime/*.css": [
        "src/runtime/*.css"
      ],
      "runtime/*.scss": [
        "src/runtime/*.scss"
      ],
      "runtime/*": [
        "src/runtime/*.ts"
      ]
    }
  },
  "dependencies": {
    "@nuxt/content": "3.6.3",
    "fireux-core": "workspace:*"
  },
  "peerDependencies": {
    "@nuxt/kit": "^4.4.0",
    "nuxt": "^4.4.0",
    "vue": "^3.5.20"
  },
  "files": [
    "src/**/*"
  ]
}
