{
  "name": "fireux-nuxtfire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/module.ts",
  "types": "./src/module.ts",
  "exports": {
    ".": "./src/module.ts",
    "./runtime/*.vue": {
      "types": "./src/runtime/*.vue",
      "default": "./src/runtime/*.vue"
    },
    "./runtime/*.css": {
      "types": "./src/runtime/*.css",
      "default": "./src/runtime/*.css"
    },
    "./runtime/*.scss": {
      "types": "./src/runtime/*.scss",
      "default": "./src/runtime/*.scss"
    },
    "./runtime/*": {
      "types": "./src/runtime/*.ts",
      "default": "./src/runtime/*.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "runtime/*.vue": [
        "src/runtime/*.vue"
      ],
      "runtime/*.css": [
        "src/runtime/*.css"
      ],
      "runtime/*.scss": [
        "src/runtime/*.scss"
      ],
      "runtime/*": [
        "src/runtime/*.ts"
      ]
    }
  },
  "files": [
    "src/**/*"
  ],
  "engines": {
    "node": ">=22.23 <23",
    "pnpm": "11.9.0"
  },
  "peerDependencies": {
    "@nuxt/kit": "^4.4.0",
    "nuxt": "^4.4.0"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "firebase-admin": "^12.7.0",
    "nuxt-vuefire": "^1.1.0",
    "vuefire": "^3.2.2"
  },
  "devDependencies": {
    "@nuxt/kit": "^4.4.0"
  }
}
