{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "stitch-seo",
    "public": ".output/public",
    "cleanUrls": true,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "function": {
          "functionId": "stitchApp",
          "region": "europe-west1"
        }
      }
    ]
  },
  "functions": [
    {
      "source": ".output/server",
      "runtime": "nodejs22",
      "entryPoint": "stitchApp"
    }
  ]
}
