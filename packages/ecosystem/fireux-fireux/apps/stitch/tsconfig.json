{
  "extends": "../../../../../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "baseUrl": ".",
    "moduleResolution": "Bundler",
    "paths": {
      "#pwa": ["@vite-pwa/nuxt/dist/runtime/composables/index"],
      "#imports": ["app/.nuxt/imports.d.ts"],
      "#build/*": ["app/.nuxt/*"],
      "fireux-core/runtime/*": ["../../../../../packages/core/fireux-core/src/runtime/*"]
    },
    "skipLibCheck": true
  },
  "include": ["./app/.nuxt/nuxt.d.ts", "./**/*", "../../../../../types/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "**/node_modules/**/@vite-pwa/nuxt/dist/runtime/components/*.vue"
  ]
}
