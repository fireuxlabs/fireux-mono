// Production: misebox-78f9c / misebox
// Local release candidate; deploy only after the complete compatibility suite passes.
// App membership: apps/{app}/users/{uid} (trusted writes only).
// Kitchen authority: kitchen_access/{uid}, apps[app] = ids + membership_created_at.
// The timestamp must equal the CURRENT membership's created.at. Team is not authority.
// Public projections, onboarding, access grants, orders, payment and publication
// are trusted server commands. Browser access is enumerated below; no child catch-all.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function own(uid) { return request.auth != null && request.auth.uid == uid; }
    function knownApp(app) {
      return app in ['misebox-app', 'baeren-ringgenberg', 'friiites', 'la-tap-berne', 'bangin-coffee', 'interlaken-essen'];
    }
    function member(app) {
      return signedIn() && knownApp(app) &&
        get(/databases/$(database)/documents/apps/$(app)/users/$(request.auth.uid)).data.role in ['user', 'admin', 'dev'];
    }
    function admin(app) {
      return member(app) &&
        get(/databases/$(database)/documents/apps/$(app)/users/$(request.auth.uid)).data.role in ['admin', 'dev'];
    }
    function currentKitchenMembership(app, access) {
      let membership = get(/databases/$(database)/documents/apps/$(app)/users/$(request.auth.uid)).data;
      return membership.role in ['user', 'admin', 'dev'] &&
        membership.created.at is timestamp && access.membership_created_at == membership.created.at;
    }
    function validKitchenIndex(index) {
      return index is map && index.keys().hasOnly(['apps']) &&
        index.apps is map && index.apps.size() <= 100 &&
        !index.apps.keys().hasAny(['', '__proto__', 'constructor', 'prototype']);
    }
    function kitchenGrantAccess(app, kitchen, access) {
      // Round-trip through strings rejects non-string ids and embedded path separators.
      return access is map && access.keys().hasOnly(['ids', 'membership_created_at']) &&
        access.membership_created_at is timestamp &&
        access.ids is list && access.ids.size() <= 50 && kitchen in access.ids &&
        access.ids.toSet().size() == access.ids.size() && !access.ids.hasAny(['', null]) &&
        access.ids == access.ids.join('/').split('/')
          ? currentKitchenMembership(app, access) : false;
    }
    function kitchenMember(kitchen) {
      let index = signedIn()
        ? get(/databases/$(database)/documents/kitchen_access/$(request.auth.uid)).data : {};
      // Validate the shared index once; membership reads remain conditional on matching grants.
      return signedIn() && validKitchenIndex(index) && (
        kitchenGrantAccess('misebox-app', kitchen, index.apps.get('misebox-app', {})) ||
        kitchenGrantAccess('baeren-ringgenberg', kitchen, index.apps.get('baeren-ringgenberg', {})) ||
        kitchenGrantAccess('friiites', kitchen, index.apps.get('friiites', {})) ||
        kitchenGrantAccess('la-tap-berne', kitchen, index.apps.get('la-tap-berne', {})) ||
        kitchenGrantAccess('bangin-coffee', kitchen, index.apps.get('bangin-coffee', {})) ||
        kitchenGrantAccess('interlaken-essen', kitchen, index.apps.get('interlaken-essen', {})));
    }
    function kitchenOperator(kitchen) {
      return exists(/databases/$(database)/documents/kitchens/$(kitchen)) && kitchenMember(kitchen);
    }
    function guestRoot(id) {
      return own(id) && request.auth.token.firebase.sign_in_provider == 'anonymous' &&
        (!exists(/databases/$(database)/documents/kitchens/$(id)) ||
          (get(/databases/$(database)/documents/kitchens/$(id)).data.created.by == id &&
           !get(/databases/$(database)/documents/kitchens/$(id)/claims/guest).data.keys().hasAny(['claimed_by'])));
    }
    function anyAppAdmin() {
      return admin('misebox-app') || admin('baeren-ringgenberg') || admin('friiites') ||
        admin('la-tap-berne') || admin('bangin-coffee') || admin('interlaken-essen');
    }

    match /blogs/{post} {
      // Public blog readers already project approved fields through server APIs.
      allow get: if (!exists(/databases/$(database)/documents/blogs/$(post)) && anyAppAdmin()) || admin(resource.data.source_app_id);
      allow list: if admin(resource.data.source_app_id);
      // Authoring and editorial approval belong to trusted commands.
    }
    match /products/{product} {
      // Product roots contain the published catalogue, never payment/customer data.
      allow get: if (!exists(/databases/$(database)/documents/products/$(product)) && anyAppAdmin()) ||
        (resource.data.visibility == 'public' && resource.data.active == true) || admin(resource.data.source_app_id);
      allow list: if (resource.data.visibility == 'public' && resource.data.active == true) || admin(resource.data.source_app_id);
      // Product creation and provider reconciliation are trusted commands.
      match /prices/{price} {
        function productAdmin() { return admin(get(/databases/$(database)/documents/products/$(product)).data.source_app_id); }
        allow read: if productAdmin();
        // Prices are written only by the provider-backed Product command.
      }
    }

    // Misebox's identity database defaults to this named runtime database.
    // Account setup/session reads its own canonical User before App membership.
    // Public profiles use server projections; private descendants remain denied.
    match /users/{uid} {
      allow get: if signedIn() && own(uid);
    }

    match /apps/{app} {
      // The existing session reads public App identity before joining. Never
      // expose legacy/unknown root fields merely because the App is known.
      function publicIdentity(d) {
        return d.keys().hasOnly(['ecosystem_id', 'role', 'status', 'name', 'short_name', 'tagline', 'description', 'social_links', 'media', 'self_join_enabled', 'created', 'updated']) &&
          (!('social_links' in d) || d.social_links.keys().hasOnly(['website', 'twitter', 'github', 'linkedin', 'instagram', 'facebook', 'youtube', 'email'])) &&
          (!('media' in d) || d.media.keys().hasOnly(['thumbnail_url', 'logo_url', 'wordmark_light_url', 'wordmark_dark_url', 'cover_url']));
      }
      allow get: if knownApp(app) && (member(app) || !exists(/databases/$(database)/documents/apps/$(app)) || publicIdentity(resource.data));
      match /users/{uid} {
        allow get: if knownApp(app) && (own(uid) || admin(app));
        allow list: if admin(app) && request.query.limit <= 100;
      }
      match /join-requests/{uid} {
        allow get: if knownApp(app) && (own(uid) || admin(app));
        allow list: if admin(app);
      }
    }
    match /kitchen_access/{uid} {
      // Reading your own index never grants access to Kitchen records.
      allow get: if signedIn() && own(uid);
    }
    match /places/{place} {
      allow get: if guestRoot(place) || kitchenMember(place);
      allow list: if kitchenMember(place);
    }
    match /kitchens/{kitchen} {
      allow get: if guestRoot(kitchen) || kitchenMember(kitchen);
      allow list: if kitchenMember(kitchen);
      // Kitchen mutations belong to trusted commands. No browser root deletion.
      // Browser permissions must not bypass their authority or invariants.
      match /{collection}/{record} {
        allow read: if collection in ['dishes', 'recipes', 'prep-items', 'stations',
          'ingredients', 'suppliers', 'supplier-ingredients', 'menus', 'orders',
          'sales', 'team', 'roles', 'waste-events', 'tests', 'offerings'] && kitchenOperator(kitchen);
      }
      match /fulfilment/policy { allow get: if kitchenOperator(kitchen); }
      match /menus/{menu}/sections/{section} {
        allow read: if kitchenOperator(kitchen);
        match /items/{item} { allow read: if kitchenOperator(kitchen); }
      }
    }
    // Server projections own public discovery and private integration records.
    // No browser writes to grants, claims, orders, sales, Team or payment state.
    match /{document=**} { allow read, write: if false; }
  }
}
