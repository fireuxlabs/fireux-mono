// @fireux-ecosystem-rules-fragment misebox/app-support
      match /join-requests/{userId} {
        // @fireux-core-rules join-validator
        allow get: if isOwner(userId) ||
          (isAppAdmin(appId) && isValidJoinRequest(resource.data));
        allow list: if isAppAdmin(appId);
        allow create, update, delete: if false;
      }

      match /financial-facts/{factId} {
        allow get, list, create, update, delete: if false;
      }

      // AppUser is membership and App governance only. Profile and Workspace
      // capability state live under their own owners.
      // @fireux-core-rules membership-block
      match /users/{userId} {
        function isValidEntityRelationship(data, idsField, primaryField) {
          return
            (!data.keys().hasAny([idsField, primaryField])) ||
            (data.keys().hasAll([idsField, primaryField]) &&
              data[idsField] is list &&
              data[idsField].size() <= 500 &&
              data[primaryField] is string &&
              (data[primaryField] == '' ||
                data[primaryField] in data[idsField]));
        }

        function isValidAppUser(data) {
          return data.keys().hasAll([
              'role',
              'subscription',
              'onboarding_status',
              'created',
              'updated'
            ]) &&
            data.keys().hasOnly([
              'role',
              'subscription',
              'onboarding_status',
              'kitchens',
              'primary_kitchen',
              'projects',
              'primary_project',
              'properties',
              'primary_property',
              'portfolios',
              'primary_portfolio',
              'suppliers',
              'primary_supplier',
              'blanks',
              'primary_blank',
              'created',
              'updated'
            ]) &&
            data.role in ['admin', 'user', 'dev'] &&
            data.subscription in ['free', 'premium', 'business'] &&
            data.onboarding_status in [
              'pending',
              'completed',
              'skipped'
            ] &&
            isValidEntityRelationship(
              data, 'kitchens', 'primary_kitchen') &&
            isValidEntityRelationship(
              data, 'projects', 'primary_project') &&
            isValidEntityRelationship(
              data, 'properties', 'primary_property') &&
            isValidEntityRelationship(
              data, 'portfolios', 'primary_portfolio') &&
            isValidEntityRelationship(
              data, 'suppliers', 'primary_supplier') &&
            isValidEntityRelationship(data, 'blanks', 'primary_blank') &&
            validCreatedStamp(data.created) &&
            validUpdatedStamp(data.updated);
        }

        allow get: if isOwner(userId) ||
          (isAppAdmin(appId) && isValidAppUser(resource.data));
        allow list: if isAppAdmin(appId) &&
          request.query.limit <= 100 &&
          isValidAppUser(resource.data);
        allow create, update, delete: if false;
      }

      // These App-owned records are trusted-server capabilities. Ignition is
      // represented by a Conversation kind, not another App collection.
      match /events/{eventId} {
        allow get, list, create, update, delete: if false;
      }

      match /conversations/{conversationId} {
        allow get, list, create, update, delete: if false;

        match /{nested=**} {
          allow get, list, create, update, delete: if false;
        }
      }

      match /marketplace-orders/{orderId} {
        allow get, list, create, update, delete: if false;
      }
    }
