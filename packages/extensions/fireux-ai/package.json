{
  "name": "fireux-ai",
  "version": "0.1.0",
  "description": "FireUX shared AI integration and presentation seam",
  "private": true,
  "main": "./src/module.ts",
  "types": "./src/module.ts",
  "exports": {
    ".": "./src/module.ts",
    "./layer": "./src/runtime/nuxt.config.ts",
    "./runtime/*.vue": {
      "types": "./src/runtime/*.vue",
      "default": "./src/runtime/*.vue"
    },
    "./runtime/*.css": {
      "types": "./src/runtime/*.css",
      "default": "./src/runtime/*.css"
    },
    "./runtime/*.scss": {
      "types": "./src/runtime/*.scss",
      "default": "./src/runtime/*.scss"
    },
    "./runtime/*": {
      "types": "./src/runtime/*.ts",
      "default": "./src/runtime/*.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "runtime/*.vue": [
        "src/runtime/*.vue"
      ],
      "runtime/*.css": [
        "src/runtime/*.css"
      ],
      "runtime/*.scss": [
        "src/runtime/*.scss"
      ],
      "runtime/*": [
        "src/runtime/*.ts"
      ]
    }
  },
  "files": [
    "src/**/*"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "dev": "nuxt-module-build --stub",
    "postbuild": "rimraf src/**/*.map",
    "clean": "rimraf dist"
  },
  "engines": {
    "node": ">=22.23 <23",
    "pnpm": "11.9.0"
  },
  "dependencies": {
    "fireux-core": "workspace:*"
  },
  "peerDependencies": {
    "nuxt": "^4.4.0",
    "@nuxt/kit": "^4.4.0",
    "@nuxt/schema": "^4.4.0",
    "h3": "*",
    "vue": "^3.5.20",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.2",
    "rimraf": "^6.0.1"
  },
  "type": "module"
}
