{
  "name": "fireux-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standard FireUX App composition",
  "exports": {
    "./config": {
      "types": "./src/config.ts",
      "development": "./src/config.ts",
      "production": "./dist/config.mjs",
      "default": "./src/config.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*",
    "dist/**/*"
  ],
  "scripts": {
    "build": "node ../../../tools/package-config/build.mjs",
    "prepack": "pnpm run build",
    "test": "node --test src/test/*.test.mjs",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "fireux-core": "workspace:*",
    "fireux-blogs": "workspace:*",
    "fireux-products": "workspace:*",
    "@nuxt/eslint": "^1.12.1",
    "fireux-ai": "workspace:*"
  },
  "peerDependencies": {
    "@nuxt/schema": "^4.6.1",
    "nuxt": "^4.6.1"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.23 <23",
    "pnpm": "11.9.0"
  }
}
