{
  "name": "fireux-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standard FireUX App composition",
  "exports": {
    "./config": {
      "types": "./src/config.ts",
      "development": "./src/config.ts",
      "production": "./dist/config.mjs",
      "default": "./src/config.ts"
    },
    "./package.json": "./package.json",
    "./layer": "./src/runtime/nuxt.config.ts",
    "./runtime/*.vue": {
      "types": "./src/runtime/*.vue",
      "default": "./src/runtime/*.vue"
    },
    "./runtime/*.css": {
      "types": "./src/runtime/*.css",
      "default": "./src/runtime/*.css"
    },
    "./runtime/*.scss": {
      "types": "./src/runtime/*.scss",
      "default": "./src/runtime/*.scss"
    },
    "./runtime/*": {
      "types": "./src/runtime/*.ts",
      "default": "./src/runtime/*.ts"
    }
  },
  "files": [
    "src/**/*",
    "dist/**/*"
  ],
  "scripts": {
    "build": "node ../../../tools/package-config/build.mjs",
    "prepack": "pnpm run build",
    "test": "node --test src/test/*.test.mjs",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "fireux-core": "workspace:*",
    "fireux-blogs": "workspace:*",
    "fireux-products": "workspace:*",
    "@nuxt/eslint": "^1.12.1",
    "fireux-ai": "workspace:*",
    "h3": "^1.15.4",
    "gsap": "^3.15.0"
  },
  "peerDependencies": {
    "@nuxt/schema": "^4.6.1",
    "nuxt": "^4.6.1",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.23 <23",
    "pnpm": "11.9.0"
  },
  "typesVersions": {
    "*": {
      "runtime/*.vue": [
        "src/runtime/*.vue"
      ],
      "runtime/*.css": [
        "src/runtime/*.css"
      ],
      "runtime/*.scss": [
        "src/runtime/*.scss"
      ],
      "runtime/*": [
        "src/runtime/*.ts"
      ]
    }
  }
}
