{
  "name": "fireux-demo",
  "version": "0.1.0",
  "description": "Cross-domain fictional Demo World contracts for FireUX products",
  "private": true,
  "type": "module",
  "main": "./src/module.ts",
  "types": "./src/module.ts",
  "exports": {
    ".": "./src/module.ts",
    "./runtime/*.vue": {
      "types": "./src/runtime/*.vue",
      "default": "./src/runtime/*.vue"
    },
    "./runtime/*.css": {
      "types": "./src/runtime/*.css",
      "default": "./src/runtime/*.css"
    },
    "./runtime/*.scss": {
      "types": "./src/runtime/*.scss",
      "default": "./src/runtime/*.scss"
    },
    "./runtime/*": {
      "types": "./src/runtime/*.ts",
      "default": "./src/runtime/*.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "runtime/*.vue": ["src/runtime/*.vue"],
      "runtime/*.css": ["src/runtime/*.css"],
      "runtime/*.scss": ["src/runtime/*.scss"],
      "runtime/*": ["src/runtime/*.ts"]
    }
  },
  "files": ["src/**/*"],
  "scripts": {
    "build": "nuxt-module-build build",
    "dev": "nuxt-module-build --stub",
    "postbuild": "rimraf src/**/*.map",
    "clean": "rimraf dist"
  },
  "engines": {
    "node": ">=22.23 <23",
    "pnpm": "11.9.0"
  },
  "peerDependencies": {
    "@nuxt/kit": "^4.4.0",
    "@nuxt/schema": "^4.4.0",
    "nuxt": "^4.4.0"
  },
  "devDependencies": {
    "@nuxt/kit": "4.4.6",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "4.4.6",
    "rimraf": "^6.0.1"
  }
}
