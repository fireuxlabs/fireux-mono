{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "#fireux-jobs-models/*": ["./src/runtime/models/*"],
      "#fireux-core-models/*": ["../../core/fireux-core/src/runtime/models/*"],
      "#fireux-core-runtime/*": ["../../core/fireux-core/src/runtime/*"],
      "#fireux-core-composables/*": [
        "../../core/fireux-core/src/runtime/composables/*"
      ]
    },
    "types": ["nuxt", "nuxt/schema", "@types/node"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": ["node_modules", "dist"]
}
