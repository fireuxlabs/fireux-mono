{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "#fireux-places-models/*": ["./src/runtime/models/*"],
      "#fireux-core-models/*": ["../../core/fireux-core/src/runtime/models/*"],
      "#fireux-core-composables/firestore/*": [
        "../../core/fireux-core/src/runtime/composables/firestore/*"
      ],
      "#fireux-core-composables/firebase/*": [
        "../../core/fireux-core/src/runtime/composables/core/firebase/*"
      ],
      "#imports": ["types/nuxt-imports.d.ts"]
    },
    "types": ["nuxt", "nuxt/schema", "@types/node"]
  },
  "include": ["src/**/*.ts", "src/runtime/env.d.ts"],
  "exclude": ["node_modules", "dist"]
}
