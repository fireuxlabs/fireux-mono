+const responseUpstreams = new WeakMap();
+function trackResponseUpstream(res, upstream) {
+	if (res.destroyed) {
+		upstream.destroy();
+		return;
+	}
+	let upstreams = responseUpstreams.get(res);
+	if (!upstreams) {
+		upstreams = new Set();
+		responseUpstreams.set(res, upstreams);
+		res.once("close", () => {
+			responseUpstreams.delete(res);
+			for (const current of upstreams) current.destroy();
+			upstreams.clear();
+		});
+	}
+	upstreams.add(upstream);
+	upstream.once("close", () => {
+		upstreams.delete(upstream);
+	});
