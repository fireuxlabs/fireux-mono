{
  "name": "bringli-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxi dev --port 3006",
    "build": "nuxi build",
    "generate": "nuxi generate",
    "preview": "nuxi preview",
    "prepare:firebase-output": "node ../../../scripts/prepare-firebase-output.mjs && pnpm --dir .output/server install --prod --ignore-workspace --ignore-scripts",
    "deploy:preflight": "node ../../../scripts/firebase-deploy-preflight.mjs --project bringli-b0517 --config firebase.json",
    "deploy": "node ../../../scripts/firebase-deploy.mjs --project bringli-b0517 --config firebase.json --app-domain https://bringli.app --auth-domains bringli.app,bringli.web.app",
    "deploy:hosting": "node ../../../scripts/firebase-deploy.mjs --project bringli-b0517 --config firebase.json --app-domain https://bringli.app --auth-domains bringli.app,bringli.web.app",
    "check:env": "node ../../../scripts/check-env.mjs",
    "postinstall": "node -e \"if(process.env.CI||process.env.GITHUB_ACTIONS) process.exit(0); require('child_process').execSync('nuxi prepare',{stdio:'inherit',env:{...process.env,CI:'1'}});\"",
    "clean": "rimraf .nuxt app/.nuxt .output dist"
  },
  "dependencies": {
    "@nuxt/icon": "2.5.1",
    "@nuxt/ui": "4.12.0",
    "fireux-bringli": "workspace:*",
    "fireux-blogs": "workspace:*",
    "fireux-companies": "workspace:*",
    "fireux-core": "workspace:*",
    "fireux-places": "workspace:*",
    "fireux-suppliers": "workspace:*",
    "nuxt": "4.6.1",
    "vue": "3.5.43",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@vite-pwa/nuxt": "1.1.1",
    "rimraf": "^6.0.1"
  }
}
