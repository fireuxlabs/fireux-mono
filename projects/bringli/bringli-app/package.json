{
  "name": "bringli-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxi dev --port 3006",
    "build": "nuxi build",
    "generate": "nuxi generate",
    "preview": "nuxi preview",
    "prepare:firebase-output": "node ../../../scripts/prepare-firebase-output.mjs && pnpm --dir .output/server install --prod --ignore-workspace",
    "deploy": "pnpm build && pnpm prepare:firebase-output && pnpm dlx firebase-tools@15.8.0 deploy --project bringli-b0517 --config firebase.json",
    "deploy:hosting": "pnpm build && pnpm prepare:firebase-output && pnpm dlx firebase-tools@15.8.0 deploy --project bringli-b0517 --config firebase.json",
    "check:env": "node ../../../scripts/check-env.mjs",
    "postinstall": "node -e \"if(process.env.CI||process.env.GITHUB_ACTIONS) process.exit(0); require('child_process').execSync('nuxi prepare',{stdio:'inherit',env:{...process.env,CI:'1'}});\"",
    "clean": "rimraf .nuxt dist"
  },
  "dependencies": {
    "@nuxt/icon": "2.x",
    "@nuxt/ui": "^4.0.0-alpha.2",
    "fireux-bringli": "workspace:*",
    "fireux-core": "workspace:*",
    "fireux-suppliers": "workspace:*",
    "nuxt": "4.1.2",
    "vue": "3.5.20",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@vite-pwa/nuxt": "^1.0.4",
    "rimraf": "^6.0.1"
  }
}
