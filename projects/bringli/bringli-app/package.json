{
  "name": "bringli-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxi dev --port 3006",
    "build": "nuxi build",
    "generate": "nuxi generate",
    "preview": "nuxi preview",
    "prepare:firebase-output": "node ../../../tools/firebase-release/cli.mjs prepare --project bringli-b0517 --config firebase.json",
    "deploy:preflight": "node ../../../tools/firebase-release/cli.mjs preflight --project bringli-b0517 --config firebase.json --rules-template ../../../packages/ecosystem/fireux-bringli/src/config/firebase/firestore.template.rules",
    "deploy": "node ../../../tools/firebase-release/cli.mjs deploy --project bringli-b0517 --config firebase.json --rules-template ../../../packages/ecosystem/fireux-bringli/src/config/firebase/firestore.template.rules",
    "deploy:hosting": "node ../../../tools/firebase-release/cli.mjs hosting --project bringli-b0517 --config firebase.json --rules-template ../../../packages/ecosystem/fireux-bringli/src/config/firebase/firestore.template.rules",
    "check:env": "node ../../../tools/firebase-release/cli.mjs env --project bringli-b0517 --config firebase.json",
    "postinstall": "node -e \"if(process.env.CI||process.env.GITHUB_ACTIONS) process.exit(0); require('child_process').execSync('nuxi prepare',{stdio:'inherit',env:{...process.env,CI:'1'}});\"",
    "clean": "rimraf .nuxt app/.nuxt .output dist",
    "build:release": "node ../../../tools/firebase-release/cli.mjs build --project bringli-b0517 --config firebase.json --app-domain https://bringli.app"
  },
  "dependencies": {
    "@nuxt/icon": "2.5.1",
    "@nuxt/ui": "4.12.0",
    "fireux-bringli": "workspace:*",
    "fireux-blogs": "workspace:*",
    "fireux-products": "workspace:*",
    "fireux-businesses": "workspace:*",
    "fireux-core": "workspace:*",
    "fireux-places": "workspace:*",
    "fireux-suppliers": "workspace:*",
    "nuxt": "4.6.1",
    "vue": "3.5.43",
    "vue-router": "5.4.0",
    "@google-cloud/functions-framework": "5.0.5"
  },
  "devDependencies": {
    "@vite-pwa/nuxt": "1.1.1",
    "rimraf": "^6.0.1"
  }
}
