{
  "name": "buenohost-app",
  "private": true,
  "type": "module",
  "imports": {
    "#internal/nuxt/paths": "./app/nuxt-internal-paths.mjs"
  },
  "scripts": {
    "dev": "nuxi dev --port 3012",
    "build": "nuxi build",
    "generate": "nuxi generate",
    "preview": "nuxi preview",
    "prepare:firebase-output": "node ../../../tools/firebase-release/cli.mjs prepare --project buenohost-ecosystem --config firebase.json",
    "deploy:preflight": "node ../../../tools/firebase-release/cli.mjs preflight --project buenohost-ecosystem --config firebase.json --rules-template ../../../packages/ecosystem/fireux-buenohost/src/config/firebase/firestore.template.rules",
    "deploy": "node ../../../tools/firebase-release/cli.mjs deploy --project buenohost-ecosystem --config firebase.json --rules-template ../../../packages/ecosystem/fireux-buenohost/src/config/firebase/firestore.template.rules",
    "deploy:hosting": "node ../../../tools/firebase-release/cli.mjs hosting --project buenohost-ecosystem --config firebase.json --rules-template ../../../packages/ecosystem/fireux-buenohost/src/config/firebase/firestore.template.rules",
    "check:env": "node ../../../tools/firebase-release/cli.mjs env --project buenohost-ecosystem --config firebase.json",
    "postinstall": "node -e \"if(process.env.CI||process.env.GITHUB_ACTIONS) process.exit(0); require('child_process').execSync('nuxi prepare',{stdio:'inherit',env:{...process.env,CI:'1'}});\"",
    "clean": "rimraf .nuxt app/.nuxt .output dist",
    "build:release": "node ../../../tools/firebase-release/cli.mjs build --project buenohost-ecosystem --config firebase.json --app-domain https://buenohost-app.web.app"
  },
  "dependencies": {
    "@nuxt/icon": "2.5.1",
    "@nuxt/ui": "4.12.0",
    "firebase-functions": "^6.3.2",
    "fireux-core": "workspace:*",
    "fireux-buenohost": "workspace:*",
    "fireux-ecosystem": "workspace:*",
    "fireux-properties": "workspace:*",
    "nuxt": "4.6.1",
    "qrcode": "^1.5.4",
    "vue": "3.5.43",
    "vue-router": "5.4.0",
    "fireux-reservations": "workspace:*",
    "@google-cloud/functions-framework": "5.0.5"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.2",
    "@iconify-json/lucide": "^1.2.62",
    "@types/qrcode": "^1.5.6",
    "@vite-pwa/nuxt": "1.1.1",
    "rimraf": "^6.0.1"
  }
}
