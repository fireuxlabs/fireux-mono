{
  // App-local TypeScript config. Mirror the Nuxt app aliases explicitly for editor resolution.
  "extends": "../tsconfig.app.base.json",
  "compilerOptions": {
    "composite": false,
    "moduleResolution": "Bundler",
    "paths": {
      "#pwa": ["../../../node_modules/@vite-pwa/nuxt/dist/runtime/composables/index"],
      "#imports": ["./.nuxt/imports.d.ts", "./app/.nuxt/imports.d.ts"],
      "#build/*": ["./.nuxt/*", "./app/.nuxt/*"],
      "~": ["./app"],
      "~/*": ["./app/*"],
      "@": ["./app"],
      "@/*": ["./app/*"],
      "fireux-core": ["../../../packages/core/fireux-core/src/module.ts"],
      "fireux-core/*": ["../../../packages/core/fireux-core/src/*"],
      "fireux-core/runtime/*": ["../../../packages/core/fireux-core/src/runtime/*"],
      "@fireux-core/*": ["../../../packages/core/fireux-core/src/runtime/*"],
      "fireux-blogs": ["../../../packages/extensions/fireux-blogs/src/module.ts"],
      "fireux-blogs/*": ["../../../packages/extensions/fireux-blogs/src/*"],
      "fireux-blogs/runtime/*": ["../../../packages/extensions/fireux-blogs/src/runtime/*"],
      "@fireux-blogs/*": ["../../../packages/extensions/fireux-blogs/src/runtime/*"],
      "fireux-cleanbox": ["../../../packages/extensions/fireux-cleanbox/src/module.ts"],
      "fireux-cleanbox/*": ["../../../packages/extensions/fireux-cleanbox/src/*"],
      "fireux-cleanbox/runtime/*": ["../../../packages/extensions/fireux-cleanbox/src/runtime/*"],
      "@fireux-cleanbox/*": ["../../../packages/extensions/fireux-cleanbox/src/runtime/*"],
      "fireux-companies": ["../../../packages/extensions/fireux-companies/src/module.ts"],
      "fireux-companies/*": ["../../../packages/extensions/fireux-companies/src/*"],
      "fireux-companies/runtime/*": ["../../../packages/extensions/fireux-companies/src/runtime/*"],
      "@fireux-companies/*": ["../../../packages/extensions/fireux-companies/src/runtime/*"],
      "fireux-jobs": ["../../../packages/extensions/fireux-jobs/src/module.ts"],
      "fireux-jobs/*": ["../../../packages/extensions/fireux-jobs/src/*"],
      "fireux-jobs/runtime/*": ["../../../packages/extensions/fireux-jobs/src/runtime/*"],
      "@fireux-jobs/*": ["../../../packages/extensions/fireux-jobs/src/runtime/*"],
      "fireux-kitchens": ["../../../packages/extensions/fireux-kitchens/src/module.ts"],
      "fireux-kitchens/*": ["../../../packages/extensions/fireux-kitchens/src/*"],
      "fireux-kitchens/runtime/*": ["../../../packages/extensions/fireux-kitchens/src/runtime/*"],
      "@fireux-kitchens/*": ["../../../packages/extensions/fireux-kitchens/src/runtime/*"],
      "fireux-places": ["../../../packages/extensions/fireux-places/src/module.ts"],
      "fireux-places/*": ["../../../packages/extensions/fireux-places/src/*"],
      "fireux-places/runtime/*": ["../../../packages/extensions/fireux-places/src/runtime/*"],
      "@fireux-places/*": ["../../../packages/extensions/fireux-places/src/runtime/*"],
      "fireux-products": ["../../../packages/extensions/fireux-products/src/module.ts"],
      "fireux-products/*": ["../../../packages/extensions/fireux-products/src/*"],
      "fireux-products/runtime/*": ["../../../packages/extensions/fireux-products/src/runtime/*"],
      "@fireux-products/*": ["../../../packages/extensions/fireux-products/src/runtime/*"]
    },
    "skipLibCheck": true
  },
  "include": ["./.nuxt/nuxt.d.ts", "./app/.nuxt/nuxt.d.ts", "./**/*", "../../../types/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "**/node_modules/**/@vite-pwa/nuxt/dist/runtime/components/*.vue"
  ]
}
