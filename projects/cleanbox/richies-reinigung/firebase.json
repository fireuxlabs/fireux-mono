{
  "functions": {
    "source": ".output/server",
    "codebase": "richies-reinigung-ssr",
    "runtime": "nodejs22"
  },
  "hosting": {
    "site": "richies-reinigung",
    "public": ".output/public",
    "cleanUrls": true,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "function": {
          "functionId": "richiesReinigung",
          "region": "us-central1"
        }
      }
    ]
  }
}
