{
  "functions": [
    {
      "source": ".output/server",
      "codebase": "richies-reinigung-ssr",
      "runtime": "nodejs22",
      "entryPoint": "richiesReinigung"
    }
  ],
  "hosting": {
    "site": "richies-reinigung",
    "public": ".output/public",
    "cleanUrls": true,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "function": {
          "functionId": "richiesReinigung",
          "codebase": "richies-reinigung-ssr",
          "region": "europe-west1"
        }
      }
    ]
  }
}
