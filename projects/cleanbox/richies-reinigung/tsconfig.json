{
  // tsconfig for Richies Reinigung app — do not override Nuxt aliases (~, @, ~~)
  "extends": "../tsconfig.app.base.json",
  "compilerOptions": {
    "composite": false,
    "baseUrl": ".",
    "moduleResolution": "Bundler",
    "paths": {
      "#pwa": ["@vite-pwa/nuxt/dist/runtime/composables/index"],
      "#imports": ["app/.nuxt/imports.d.ts", ".nuxt/imports.d.ts"],
      "#build/*": ["app/.nuxt/*", ".nuxt/*"]
      // Do NOT override ~/*, @/*, ~~/* here; Nuxt sets them to srcDir (app/)
    },
    "skipLibCheck": true
  },
  "include": ["./app/.nuxt/nuxt.d.ts", "./.nuxt/nuxt.d.ts", "./**/*", "../../../types/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "**/node_modules/**/@vite-pwa/nuxt/dist/runtime/components/*.vue"
  ]
}
