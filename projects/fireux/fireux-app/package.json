{
  "name": "fireux-platform-app",
  "private": true,
  "type": "module",
  "imports": {
    "#internal/nuxt/paths": "./app/nuxt-internal-paths.mjs"
  },
  "scripts": {
    "ignition:prepare": "node --experimental-strip-types ignition/prepare.mjs",
    "dev": "nuxi dev --port 3000",
    "build": "nuxi build",
    "generate": "nuxi generate",
    "preview": "nuxi preview",
    "prepare:firebase-output": "node ../../../tools/firebase-release/cli.mjs prepare --project fireux-2005 --config firebase.json",
    "deploy:preflight": "node ../../../tools/firebase-release/cli.mjs preflight --project fireux-2005 --config firebase.json --rules-template ../../../packages/ecosystem/fireux-fireux/src/config/firebase/firestore.template.rules",
    "deploy": "node ../../../tools/firebase-release/cli.mjs deploy --project fireux-2005 --config firebase.json --rules-template ../../../packages/ecosystem/fireux-fireux/src/config/firebase/firestore.template.rules",
    "deploy:hosting": "node ../../../tools/firebase-release/cli.mjs hosting --project fireux-2005 --config firebase.json --rules-template ../../../packages/ecosystem/fireux-fireux/src/config/firebase/firestore.template.rules",
    "check:env": "node ../../../tools/firebase-release/cli.mjs env --project fireux-2005 --config firebase.json",
    "postinstall": "node -e \"if(process.env.CI||process.env.GITHUB_ACTIONS) process.exit(0); require('child_process').execSync('nuxi prepare',{stdio:'inherit',env:{...process.env,CI:'1'}});\"",
    "clean": "rimraf .nuxt app/.nuxt .output dist",
    "build:release": "node ../../../tools/firebase-release/cli.mjs build --project fireux-2005 --config firebase.json --app-domain https://fireux.app"
  },
  "dependencies": {
    "@nuxt/icon": "2.5.1",
    "@nuxt/ui": "4.12.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.2",
    "fireux-ai": "workspace:*",
    "fireux-blogs": "workspace:*",
    "fireux-core": "workspace:*",
    "fireux-docs": "workspace:*",
    "fireux-ecosystem": "workspace:*",
    "fireux-fireux": "workspace:*",
    "fireux-ignite": "workspace:*",
    "fireux-products": "workspace:*",
    "h3": "^1.15.4",
    "nuxt": "4.6.1",
    "vue": "3.5.43",
    "vue-router": "5.4.0",
    "@google-cloud/functions-framework": "5.0.5",
    "fireux-projects": "workspace:*",
    "fireux-app": "workspace:*"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.2",
    "@iconify-json/logos": "^1.2.10",
    "@iconify-json/lucide": "^1.2.82",
    "@iconify-json/skill-icons": "^1.2.3",
    "@iconify-json/vscode-icons": "^1.2.37",
    "@vite-pwa/nuxt": "1.1.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "4.3.3"
  }
}
