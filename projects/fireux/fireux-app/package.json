{
  "name": "fireux-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxi prepare && nuxi dev --port 3000",
    "build": "nuxi build",
    "generate": "nuxi generate",
    "preview": "nuxi preview",
    "check:env": "node ../../../scripts/check-env.mjs",
    "postinstall": "node -e \"if(process.env.CI||process.env.GITHUB_ACTIONS) process.exit(0); require('child_process').execSync('nuxi prepare',{stdio:'inherit'});\"",
    "clean": "rimraf .nuxt dist"
  },
  "dependencies": {
    "@nuxt/content": "^3.6.3",
    "@nuxt/icon": "2.x",
    "@nuxt/ui": "^4.0.0-alpha.2",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.2",
    "fireux-core": "workspace:*",
    "fireux-fireux": "workspace:*",
    "nuxt": "4.1.2",
    "vue": "3.5.20",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@vite-pwa/nuxt": "^1.0.4",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.12"
  }
}

