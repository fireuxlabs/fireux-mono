{
  "name": "fireux-app",
  "private": true,
  "type": "module",
  "imports": {
    "#internal/nuxt/paths": "./app/nuxt-internal-paths.mjs"
  },
  "scripts": {
    "dev": "nuxi dev --port 3000",
    "build": "nuxi build",
    "generate": "nuxi generate",
    "preview": "nuxi preview",
    "prepare:firebase-output": "node ../../../scripts/prepare-firebase-output.mjs && pnpm --dir .output/server install --prod",
    "deploy:preflight": "node ../../../scripts/firebase-deploy-preflight.mjs --project fireux-2005 --config firebase.json",
    "deploy": "node ../../../scripts/firebase-deploy.mjs --project fireux-2005 --config firebase.json --app-domain https://fireux.app --auth-domains fireux.app,fireux.web.app,workspace.fireux.app",
    "deploy:hosting": "node ../../../scripts/firebase-deploy.mjs --project fireux-2005 --config firebase.json --app-domain https://fireux.app --auth-domains fireux.app,fireux.web.app,workspace.fireux.app",
    "check:env": "node ../../../scripts/check-env.mjs",
    "postinstall": "node -e \"if(process.env.CI||process.env.GITHUB_ACTIONS) process.exit(0); require('child_process').execSync('nuxi prepare',{stdio:'inherit',env:{...process.env,CI:'1'}});\"",
    "clean": "rimraf .nuxt app/.nuxt .output dist"
  },
  "dependencies": {
    "@nuxt/content": "3.6.3",
    "@nuxt/icon": "2.5.1",
    "@nuxt/ui": "4.12.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.2",
    "fireux-ai": "workspace:*",
    "fireux-blogs": "workspace:*",
    "fireux-core": "workspace:*",
    "fireux-docs": "workspace:*",
    "fireux-fireux": "workspace:*",
    "fireux-ignite": "workspace:*",
    "fireux-misebox": "workspace:*",
    "fireux-products": "workspace:*",
    "h3": "^1.15.4",
    "nuxt": "4.6.1",
    "vue": "3.5.43",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.2",
    "@iconify-json/logos": "^1.2.10",
    "@iconify-json/lucide": "^1.2.82",
    "@iconify-json/skill-icons": "^1.2.3",
    "@iconify-json/vscode-icons": "^1.2.37",
    "@vite-pwa/nuxt": "1.1.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "4.3.3"
  }
}
