{
  "name": "lifeguard-community-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxi dev --port 3031",
    "build": "nuxi build",
    "generate": "nuxi generate",
    "preview": "nuxi preview",
    "prepare:firebase-output": "node ../../../tools/firebase-release/cli.mjs prepare --project fireux-2005 --config firebase.json",
    "deploy:preflight": "node ../../../tools/firebase-release/cli.mjs preflight --project fireux-2005 --config firebase.json --rules-template ../../../packages/ecosystem/fireux-fireux/src/config/firebase/firestore.template.rules --rules-databases fireux,lifeguard-community",
    "deploy": "node ../../../tools/firebase-release/cli.mjs deploy --project fireux-2005 --config firebase.json --rules-template ../../../packages/ecosystem/fireux-fireux/src/config/firebase/firestore.template.rules --rules-databases fireux,lifeguard-community",
    "deploy:hosting": "node ../../../tools/firebase-release/cli.mjs hosting --project fireux-2005 --config firebase.json --rules-template ../../../packages/ecosystem/fireux-fireux/src/config/firebase/firestore.template.rules --rules-databases fireux,lifeguard-community",
    "build:release": "node ../../../tools/firebase-release/cli.mjs build --project fireux-2005 --config firebase.json --app-domain https://lifeguard-community-fireux-2005.web.app"
  },
  "dependencies": {
    "@nuxt/icon": "2.5.1",
    "@nuxt/ui": "4.12.0",
    "fireux-blogs": "workspace:*",
    "fireux-products": "workspace:*",
    "fireux-core": "workspace:*",
    "fireux-fireux": "workspace:*",
    "nuxt": "4.6.1",
    "vue": "3.5.43",
    "vue-router": "5.4.0",
    "@google-cloud/functions-framework": "5.0.5"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.62",
    "@vite-pwa/nuxt": "1.1.1",
    "rimraf": "^6.0.1"
  }
}
