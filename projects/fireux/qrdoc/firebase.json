{
  "functions": [
    {
      "source": ".output/server",
      "codebase": "qrdoc-ssr",
      "runtime": "nodejs22",
      "entryPoint": "qrdoc"
    }
  ],
  "hosting": {
    "site": "qrdoc",
    "public": ".output/public",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "function": {
          "functionId": "qrdoc",
          "codebase": "qrdoc-ssr",
          "region": "europe-west1"
        }
      }
    ]
  }
}
