{
  // tsconfig for Tenant app — do not override Nuxt aliases (~, @, ~~)
  "extends": "../tsconfig.app.base.json",
  "compilerOptions": {
    "composite": false,
    "baseUrl": ".",
    "moduleResolution": "Bundler",
    "paths": {
      "#pwa": ["@vite-pwa/nuxt/dist/runtime/composables/index"],
      "#imports": [".nuxt/imports.d.ts"],
      "#build/*": [".nuxt/*"],

      "fireux-core": ["../../../packages/core/fireux-core/src/module.ts"],
      "fireux-core/*": ["../../../packages/core/fireux-core/src/*"],
      "fireux-core/runtime/*": ["../../../packages/core/fireux-core/src/runtime/*"],
      "@fireux-core/*": ["../../../packages/core/fireux-core/src/*"],

      "fireux-fireux": ["../../../packages/ecosystem/fireux-fireux/src/module.ts"],
      "fireux-fireux/*": ["../../../packages/ecosystem/fireux-fireux/src/*"],
      "fireux-fireux/runtime/*": ["../../../packages/ecosystem/fireux-fireux/src/runtime/*"],
      "@fireux-fireux/*": ["../../../packages/ecosystem/fireux-fireux/src/*"]

      // Do NOT override ~/*, @/*, ~~/* here; Nuxt sets them to srcDir (app/)
    },
    "skipLibCheck": true
  },
  "include": [
    "./.nuxt/nuxt.d.ts",
    "./**/*.ts",
    "./**/*.d.ts",
    "../../../types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/**/@vite-pwa/nuxt/dist/runtime/components/*.vue"
  ]
}
