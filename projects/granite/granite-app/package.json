{
  "name": "granite-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxi dev --port 3007",
    "build": "nuxi build",
    "generate": "nuxi generate",
    "preview": "nuxi preview",
    "prepare:firebase-output": "node ../../../tools/firebase-release/cli.mjs prepare --project granite-ecosystem --config firebase.json",
    "deploy:preflight": "node ../../../tools/firebase-release/cli.mjs preflight --project granite-ecosystem --config firebase.json --rules-template ../../../packages/ecosystem/fireux-granite/src/config/firebase/firestore.template.rules",
    "deploy": "node ../../../tools/firebase-release/cli.mjs deploy --project granite-ecosystem --config firebase.json --rules-template ../../../packages/ecosystem/fireux-granite/src/config/firebase/firestore.template.rules",
    "deploy:hosting": "node ../../../tools/firebase-release/cli.mjs hosting --project granite-ecosystem --config firebase.json --rules-template ../../../packages/ecosystem/fireux-granite/src/config/firebase/firestore.template.rules",
    "check:env": "node ../../../tools/firebase-release/cli.mjs env --project granite-ecosystem --config firebase.json",
    "postinstall": "node -e \"if(process.env.CI||process.env.GITHUB_ACTIONS) process.exit(0); require('child_process').execSync('nuxi prepare',{stdio:'inherit',env:{...process.env,CI:'1'}});\"",
    "clean": "rimraf .nuxt app/.nuxt .output dist",
    "build:release": "node ../../../tools/firebase-release/cli.mjs build --project granite-ecosystem --config firebase.json --app-domain https://granite-os.web.app"
  },
  "dependencies": {
    "@iconify-json/heroicons": "^1.2.2",
    "@iconify-json/logos": "^1.2.10",
    "@iconify-json/lucide": "^1.2.82",
    "@iconify-json/skill-icons": "^1.2.3",
    "@iconify-json/vscode-icons": "^1.2.37",
    "@nuxt/icon": "2.5.1",
    "@nuxt/ui": "4.12.0",
    "fireux-blogs": "workspace:*",
    "fireux-products": "workspace:*",
    "fireux-core": "workspace:*",
    "fireux-granite": "workspace:*",
    "fireux-properties": "workspace:*",
    "nuxt": "4.6.1",
    "vue": "3.5.43",
    "vue-router": "5.4.0",
    "fireux-compliance": "workspace:*",
    "fireux-documents": "workspace:*",
    "fireux-tasks": "workspace:*",
    "@google-cloud/functions-framework": "5.0.5"
  },
  "devDependencies": {
    "@vite-pwa/nuxt": "1.1.1",
    "rimraf": "^6.0.1"
  }
}
