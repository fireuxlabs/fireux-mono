{
  // App-local TypeScript config. Mirror the Nuxt app aliases explicitly for editor resolution.
  "extends": "../../tsconfig.projects.json",
  "files": [],
  "compilerOptions": {
    "paths": {
      "#components": ["./.nuxt/components.d.ts", "./app/.nuxt/components.d.ts"],
      "#pwa": [
        "../../../node_modules/@vite-pwa/nuxt/dist/runtime/composables/index"
      ],
      "#imports": [
        "./.nuxt/imports.d.ts",
        "./app/.nuxt/imports.d.ts"
      ],
      "#build/*": ["./.nuxt/*", "./app/.nuxt/*"],
      "~": ["./app"],
      "~/*": ["./app/*"],
      "@": ["./app"],
      "@/*": ["./app/*"],
      "fireux-core": ["../../../packages/core/fireux-core/src/module.ts"],
      "fireux-core/*": ["../../../packages/core/fireux-core/src/*"],
      "fireux-core/runtime/*": [
        "../../../packages/core/fireux-core/src/runtime/*"
      ],
      "fireux-blogs": [
        "../../../packages/extensions/fireux-blogs/src/module.ts"
      ],
      "fireux-blogs/*": ["../../../packages/extensions/fireux-blogs/src/*"],
      "fireux-blogs/runtime/*": [
        "../../../packages/extensions/fireux-blogs/src/runtime/*"
      ],
      "fireux-companies": [
        "../../../packages/extensions/fireux-companies/src/module.ts"
      ],
      "fireux-companies/*": [
        "../../../packages/extensions/fireux-companies/src/*"
      ],
      "fireux-companies/runtime/*": [
        "../../../packages/extensions/fireux-companies/src/runtime/*"
      ],
      "fireux-go-qr": [
        "../../../packages/extensions/fireux-go-qr/src/module.ts"
      ],
      "fireux-go-qr/*": ["../../../packages/extensions/fireux-go-qr/src/*"],
      "fireux-go-qr/runtime/*": [
        "../../../packages/extensions/fireux-go-qr/src/runtime/*"
      ],
      "fireux-jobs": ["../../../packages/extensions/fireux-jobs/src/module.ts"],
      "fireux-jobs/*": ["../../../packages/extensions/fireux-jobs/src/*"],
      "fireux-jobs/runtime/*": [
        "../../../packages/extensions/fireux-jobs/src/runtime/*"
      ],
      "fireux-kitchens": [
        "../../../packages/extensions/fireux-kitchens/src/module.ts"
      ],
      "fireux-kitchens/*": [
        "../../../packages/extensions/fireux-kitchens/src/*"
      ],
      "fireux-kitchens/runtime/*": [
        "../../../packages/extensions/fireux-kitchens/src/runtime/*"
      ],
      "fireux-misebox": [
        "../../../packages/ecosystem/fireux-misebox/src/module.ts"
      ],
      "fireux-misebox/*": ["../../../packages/ecosystem/fireux-misebox/src/*"],
      "fireux-misebox/runtime/*": [
        "../../../packages/ecosystem/fireux-misebox/src/runtime/*"
      ],
      "fireux-places": [
        "../../../packages/extensions/fireux-places/src/module.ts"
      ],
      "fireux-places/*": ["../../../packages/extensions/fireux-places/src/*"],
      "fireux-places/runtime/*": [
        "../../../packages/extensions/fireux-places/src/runtime/*"
      ],
      "fireux-products": [
        "../../../packages/extensions/fireux-products/src/module.ts"
      ],
      "fireux-products/*": [
        "../../../packages/extensions/fireux-products/src/*"
      ],
      "fireux-products/runtime/*": [
        "../../../packages/extensions/fireux-products/src/runtime/*"
      ],
      "fireux-sproochli": [
        "../../../packages/extensions/fireux-sproochli/src/module.ts"
      ],
      "fireux-sproochli/*": [
        "../../../packages/extensions/fireux-sproochli/src/*"
      ],
      "fireux-sproochli/runtime/*": [
        "../../../packages/extensions/fireux-sproochli/src/runtime/*"
      ],
      "fireux-suppliers": [
        "../../../packages/extensions/fireux-suppliers/src/module.ts"
      ],
      "fireux-suppliers/*": [
        "../../../packages/extensions/fireux-suppliers/src/*"
      ],
      "fireux-suppliers/runtime/*": [
        "../../../packages/extensions/fireux-suppliers/src/runtime/*"
      ]
    }
  },
  "include": [
    "./.nuxt/nuxt.d.ts",
    "./app/.nuxt/nuxt.d.ts",
    "./**/*",
    "../../../types/**/*.d.ts"
  ],
  "exclude": [
    "../../../types/nuxt-shims.d.ts",
    "node_modules",
    "**/node_modules/**/@vite-pwa/nuxt/dist/runtime/components/*.vue"
  ]
}
