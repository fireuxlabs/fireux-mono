{
  "name": "interlaken-essen",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxi dev --port 3026",
    "build": "nuxi build",
    "prepare:firebase-output": "node ../../../scripts/prepare-firebase-output.mjs && pnpm --dir .output/server install --prod --ignore-workspace --ignore-scripts",
    "generate": "nuxi generate",
    "preview": "nuxi preview",
    "deploy": "node ../../../scripts/firebase-deploy.mjs --project misebox-78f9c --config firebase.json --auth-domains interlaken-essen.misebox.app,interlaken-essen.web.app",
    "deploy:hosting": "node ../../../scripts/firebase-deploy.mjs --project misebox-78f9c --config firebase.json --auth-domains interlaken-essen.misebox.app,interlaken-essen.web.app",
    "check:env": "node ../../../scripts/check-env.mjs",
    "postinstall": "node -e \"if(process.env.CI||process.env.GITHUB_ACTIONS) process.exit(0); require('child_process').execSync('nuxi prepare',{stdio:'inherit',env:{...process.env,CI:'1'}});\"",
    "clean": "rimraf .nuxt app/.nuxt .output dist"
  },
  "dependencies": {
    "@nuxt/icon": "2.x",
    "@nuxt/ui": "^4.0.0-alpha.2",
    "firebase": "11.10.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.2",
    "fireux-blogs": "workspace:*",
    "fireux-core": "workspace:*",
    "fireux-marketplace": "workspace:*",
    "fireux-misebox": "workspace:*",
    "fireux-sproochli": "workspace:*",
    "h3": "^1.15.4",
    "nuxt": "4.4.6",
    "vue": "3.5.20",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.62",
    "@vite-pwa/nuxt": "^1.0.4",
    "rimraf": "^6.0.1"
  }
}
