{
  "name": "misebox-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxi dev --port 3001",
    "build": "nuxi build",
    "generate": "nuxi generate",
    "preview": "nuxi preview",
    "prepare:firebase-output": "node ../../../scripts/prepare-firebase-output.mjs && pnpm --dir .output/server install --prod --ignore-workspace --ignore-scripts",
    "deploy:preflight": "node ../../../scripts/firebase-deploy-preflight.mjs --project misebox-78f9c --config firebase.json",
    "deploy": "node ../../../scripts/firebase-deploy.mjs --project misebox-78f9c --config firebase.json --app-domain https://misebox.app --auth-domains misebox.app,misebox-78f9c.web.app,jobs.misebox.app,suppliers.misebox.app",
    "deploy:hosting": "node ../../../scripts/firebase-deploy.mjs --project misebox-78f9c --config firebase.json --app-domain https://misebox.app --auth-domains misebox.app,misebox-78f9c.web.app,jobs.misebox.app,suppliers.misebox.app",
    "check:env": "node ../../../scripts/check-env.mjs",
    "postinstall": "node -e \"if(process.env.CI||process.env.GITHUB_ACTIONS) process.exit(0); require('child_process').execSync('nuxi prepare',{stdio:'inherit',env:{...process.env,CI:'1'}});\"",
    "clean": "rimraf .nuxt app/.nuxt .output dist"
  },
  "dependencies": {
    "@iconify-json/heroicons": "^1.2.2",
    "@iconify-json/logos": "^1.2.10",
    "@iconify-json/lucide": "^1.2.66",
    "@iconify-json/skill-icons": "^1.2.3",
    "@iconify-json/vscode-icons": "^1.2.37",
    "@nuxt/fonts": "^0.11.4",
    "@nuxt/icon": "2.x",
    "@nuxt/ui": "^4.0.0-alpha.2",
    "better-sqlite3": "^12.6.0",
    "firebase-functions": "^6.3.2",
    "fireux-ai": "workspace:*",
    "fireux-blogs": "workspace:*",
    "fireux-companies": "workspace:*",
    "fireux-core": "workspace:*",
    "fireux-demo": "workspace:*",
    "fireux-go-qr": "workspace:*",
    "fireux-suppliers": "workspace:*",
    "fireux-jobs": "workspace:*",
    "fireux-kitchens": "workspace:*",
    "fireux-misebox": "workspace:*",
    "fireux-places": "workspace:*",
    "fireux-sproochli": "workspace:*",
    "h3": "^1.15.4",
    "nuxt": "4.4.6",
    "stripe": "^22.1.1",
    "vue": "3.5.20",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@vite-pwa/nuxt": "^1.0.4",
    "rimraf": "^6.0.1",
    "vuefire": "3.2.2"
  }
}
