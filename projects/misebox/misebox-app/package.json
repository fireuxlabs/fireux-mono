{
  "name": "misebox-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxi prepare && nuxi dev --port 3001",
    "build": "nuxi build",
    "generate": "nuxi generate",
    "preview": "nuxi preview",
    "deploy": "npx firebase-tools@15.5.1 deploy --only hosting --project misebox-78f9c --config firebase.json",
    "check:env": "node ../../../scripts/check-env.mjs",
    "postinstall": "node -e \"if(process.env.CI||process.env.GITHUB_ACTIONS) process.exit(0); require('child_process').execSync('nuxi prepare',{stdio:'inherit'});\"",
    "clean": "rimraf .nuxt dist",
    "migrate:chefs": "tsx scripts/migrate-chef-data.ts"
  },
  "dependencies": {
    "@iconify-json/heroicons": "^1.2.2",
    "@iconify-json/logos": "^1.2.10",
    "@iconify-json/lucide": "^1.2.66",
    "@iconify-json/skill-icons": "^1.2.3",
    "@iconify-json/vscode-icons": "^1.2.37",
    "@nuxt/icon": "2.x",
    "@nuxt/ui": "^4.0.0-alpha.2",
    "better-sqlite3": "^12.6.0",
    "dompurify": "^3.2.6",
    "firebase-functions": "^6.3.2",
    "fireux-companies": "workspace:*",
    "fireux-core": "workspace:*",
    "fireux-jobs": "workspace:*",
    "fireux-kitchens": "workspace:*",
    "fireux-misebox": "workspace:*",
    "fireux-places": "workspace:*",
    "nuxt": "4.1.2",
    "vue": "3.5.20",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.2",
    "@iconify-json/lucide": "^1.2.62",
    "@nuxt/content": "^3.6.3",
    "@vite-pwa/nuxt": "^1.0.4",
    "rimraf": "^6.0.1",
    "vuefire": "3.2.2"
  }
}
