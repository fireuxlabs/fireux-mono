{
  // tsconfig for Misebox app — do not override Nuxt aliases (~, @, ~~)
  "extends": "../tsconfig.app.base.json",
  "compilerOptions": {
    "composite": false,
    "baseUrl": ".",
    "moduleResolution": "Bundler",
    "paths": {
      "#pwa": ["@vite-pwa/nuxt/dist/runtime/composables/index"],
      "#imports": [".nuxt/imports.d.ts"],
      "#build/*": [".nuxt/*"]
      // Do NOT override ~/*, @/*, ~~/* here; Nuxt sets them to srcDir (app/)
    },
    "skipLibCheck": true,
    "types": ["nuxt", "vite/client", "@vite-pwa/nuxt"]
  },
  "include": [
    "./.nuxt/nuxt.d.ts",
    "./**/*.ts",
    "./**/*.d.ts",
    "../../../types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/**/@vite-pwa/nuxt/dist/runtime/components/*.vue"
  ]
}
