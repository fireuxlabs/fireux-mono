{
  "functions": [
    {
      "source": ".output/server",
      "codebase": "niederhorn-ssr",
      "runtime": "nodejs22",
      "entryPoint": "niederhornServer"
    }
  ],
  "hosting": {
    "site": "niederhorn",
    "public": ".output/public",
    "cleanUrls": true,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "function": {
          "functionId": "niederhornServer",
          "codebase": "niederhorn-ssr",
          "region": "us-central1"
        }
      }
    ]
  }
}
