{
  "name": "swiss-alpine-guides",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 3036 --host 127.0.0.1",
    "prepare": "nuxt prepare",
    "build": "nuxt build",
    "build:release": "node ../../../tools/firebase-release/cli.mjs build --project slap-45389 --config firebase.json --app-domain https://prototype-swiss-alpine-guides.web.app",
    "prepare:firebase-output": "node ../../../tools/firebase-release/cli.mjs prepare --project slap-45389 --config firebase.json",
    "deploy:preflight": "node ../../../tools/firebase-release/cli.mjs preflight --project slap-45389 --config firebase.json --rules-policy development --rules-template ../../../packages/ecosystem/fireux-slap/src/config/firebase/firestore.template.rules",
    "deploy:preview": "node ../../../tools/firebase-release/cli.mjs deploy --project slap-45389 --config firebase.json --rules-policy development --rules-template ../../../packages/ecosystem/fireux-slap/src/config/firebase/firestore.template.rules",
    "typecheck": "nuxt typecheck",
    "generate": "nuxt generate",
    "test": "node --test tests/enquiry.test.mjs",
    "deploy:preview-alias": "firebase hosting:clone prototype-swiss-alpine-guides:live swiss-alpine-guides-prototype:live --project slap-45389",
    "test:seo": "node --test tests/seo.test.mjs",
    "test:site": "node --test tests/complete-site.test.mjs"
  },
  "dependencies": {
    "@nuxt/ui": "4.12.0",
    "fireux-app": "workspace:*",
    "fireux-core": "workspace:*",
