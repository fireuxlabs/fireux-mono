rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed data model
    // ===============================================================
    // properties/{propertyId}: canonical Property root.
    // apps/{appId}/users/{uid}: private App membership authority.
    // apps/{appId}/properties/{propertyId}: Property access support.
    // properties/{propertyId}/reservations/{reservationId}: server-owned
    //   private guest PII, stay, money, notes, channel, sync, and audit truth.
    // properties/{propertyId}/reservation-nights/{date}: server-owned atomic
    //   availability claim for one valid YYYY-MM-DD night.
    // All browser access is initially denied. Trusted authenticated server
    // handlers use the Admin SDK and validate App/Property authority.

    function isAuthenticated() {
      return request.auth != null &&
        (!('firebase' in request.auth.token) ||
          !('sign_in_provider' in request.auth.token.firebase) ||
          request.auth.token.firebase.sign_in_provider != 'anonymous');
    }

    function isValidReservation(data, propertyId) {
      return data.keys().hasAll([
          'property_id', 'guest', 'source', 'external_reference', 'status',
          'arrival_date', 'departure_date', 'adults', 'children', 'total',
          'notes', 'sync', 'created', 'updated'
        ]) &&
        data.keys().hasOnly([
          'property_id', 'guest', 'source', 'external_reference', 'status',
          'arrival_date', 'departure_date', 'adults', 'children', 'total',
          'notes', 'sync', 'created', 'updated'
        ]) &&
        data.property_id == propertyId &&
        data.guest is map &&
        data.guest.keys().hasAll(['display_name', 'email', 'phone']) &&
        data.guest.keys().hasOnly(['display_name', 'email', 'phone']) &&
        data.guest.display_name is string &&
        data.guest.display_name.size() >= 1 && data.guest.display_name.size() <= 160 &&
        data.guest.email is string && data.guest.email.size() <= 320 &&
        data.guest.phone is string && data.guest.phone.size() <= 80 &&
        data.source in ['direct', 'airbnb', 'booking_com', 'vrbo', 'manual', 'other'] &&
        data.external_reference is string && data.external_reference.size() <= 240 &&
        data.status in ['inquiry', 'hold', 'confirmed', 'checked_in', 'checked_out', 'cancelled'] &&
        data.arrival_date is string && data.arrival_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.departure_date is string && data.departure_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.adults is int && data.adults >= 1 && data.adults <= 100 &&
        data.children is int && data.children >= 0 && data.children <= 100 &&
        (data.total == null ||
          (data.total is map &&
            data.total.keys().hasAll(['amount_minor', 'currency_code']) &&
            data.total.keys().hasOnly(['amount_minor', 'currency_code']) &&
            data.total.amount_minor is int && data.total.amount_minor >= 0 &&
            data.total.currency_code is string &&
            data.total.currency_code.matches('^[A-Z]{3}$'))) &&
        data.notes is string && data.notes.size() <= 4000 &&
        data.sync is map &&
        data.sync.keys().hasAll(['state', 'channel_updated_at']) &&
        data.sync.keys().hasOnly(['state', 'channel_updated_at']) &&
        data.sync.state in ['local', 'synced', 'pending', 'stale', 'error'] &&
        (data.sync.channel_updated_at == null || data.sync.channel_updated_at is timestamp) &&
        data.created is map && data.created.at is timestamp &&
        data.updated is map && data.updated.at is timestamp;
    }

    function isValidReservationNight(data, propertyId, date) {
      return data.keys().hasAll(['property_id', 'reservation_id', 'date', 'created']) &&
        data.keys().hasOnly(['property_id', 'reservation_id', 'date', 'created']) &&
        data.property_id == propertyId &&
        data.reservation_id is string && data.reservation_id.size() >= 1 &&
        data.reservation_id.size() <= 1500 &&
        data.date == date && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.created is map && data.created.at is timestamp;
    }

    match /properties/{propertyId}/reservations/{reservationId} {
      allow get, list, delete: if false;
      allow create: if false && isValidReservation(request.resource.data, propertyId);
      allow update: if false && isValidReservation(request.resource.data, propertyId);
    }

    match /properties/{propertyId}/reservation-nights/{date} {
      allow get, list, delete: if false;
      allow create: if false && isValidReservationNight(request.resource.data, propertyId, date);
      allow update: if false && isValidReservationNight(request.resource.data, propertyId, date);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
