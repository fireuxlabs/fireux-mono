// Concurrent edit — 2026-07-20 12:55 CEST — Security spine: default-deny raw public roots and constrain Driver order access to open deliveries.
// Concurrent edit — 2026-07-20 13:19 CEST — Account consent follow-up: make trusted server provisioning the sole public User create path.
// Concurrent edit — 2026-07-20 13:12 CEST — Driver dispatch privacy: keep full Kitchen Orders operator-only.
// Concurrent edit — 2026-07-20 13:10 CEST — User handle security pass: require server-owned canonical handle reservations.
// Concurrent edit — 2026-07-20 13:51 CEST — User handle contract: align public identity validation with the trusted 30-character canonical slug.
// Concurrent edit — 2026-07-20 13:29 CEST — Root profile identity cutover: remove embedded User snapshots and preserve owner missing-document gets.
// Concurrent edit — 2026-07-20 13:42 CEST — Security rollout gate: keep migration evidence server-only.
// Concurrent edit — 2026-07-20 15:59 CEST — Repo Efficiency Pass 1 of 6: close raw App access, pin bootstrap identity, and repair executable security contracts.
// Concurrent edit — 2026-07-20 19:58 CEST — Repo Efficiency Pass 2 of 6: preserve strict Professional validation within the Rules expression budget.
// Concurrent edit — 2026-07-20 19:51 CEST — Repo Efficiency Pass 2 of 6: preserve strict Agent/Chef validation within the Rules expression budget.
// Concurrent edit — 2026-07-20 20:02 CEST — Repo Efficiency Pass 2 of 6 rules cutover: make raw public-profile roots owner-only and validate one changed Professional list family.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed data model
    // ===============================================================
    // users/{uid}: public identity only (display_name, optional bio, avatar,
    //   handle). No email
    //   or private settings.
    // users/{uid}/private/account: owner-only email, preferences, terms.
    // users/{uid}/notifications/{id}: owner-only notification records.
    // apps/{appId}: canonical App truth. Guests use allowlisted server DTOs;
    //   raw reads require App membership or the fixed bootstrap developer.
    // apps/{appId}/join-requests/{uid}: owner-visible/admin-listable request.
    // apps/{appId}/users/{uid}: private membership and capability authority.
    // users/{uid}/profiles/{kind}: User-owned role profile.
    // users/{uid}/profiles/{kind}/app-state/{appId}: App-specific profile
    //   capability and server-owned grants where the role needs them.
    // apps/{appId}/kitchens/{kitchenId}/orders/{orderId}: private order PII;
    //   client reads are restricted to Kitchen operators. Granted Drivers use
    //   authenticated server-projected dispatch beacons instead.
    // apps/{appId}/kitchens/{kitchenId}/sales/{saleId}: immutable, PII-free
    //   completed-Order facts readable by App admins and Kitchen operators.
    // apps/{appId}/financial-facts/{factId}: immutable normalized finance
    //   facts; raw records remain server-only until bounded reports exist.

    // ===============================================================
    // Shared helpers
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null &&
        (
          !('firebase' in request.auth.token) ||
          !('sign_in_provider' in request.auth.token.firebase) ||
          request.auth.token.firebase.sign_in_provider != 'anonymous'
        );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isBootstrapDeveloper() {
      return isAuthenticated() &&
        request.auth.uid == 'jMK33p5XlhYS8rBCEf8qUiogfMg2';
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function validOptionalText(data, field, maxSize) {
      return !(field in data) ||
        (data[field] is string && data[field].size() <= maxSize);
    }

    function validRequiredText(data, field, minSize, maxSize) {
      return field in data &&
        data[field] is string &&
        data[field].size() >= minSize &&
        data[field].size() <= maxSize;
    }

    function validOptionalList(data, field, maxSize) {
      return !(field in data) ||
        (data[field] is list && data[field].size() <= maxSize);
    }

    function isValidHttpsUrl(value, maxSize) {
      return value is string &&
        value.size() <= maxSize &&
        (value == '' || value.matches('^https://.+$'));
    }

    function isValidUserAvatar(value) {
      return value == '/img/ecosystem/avatar.png' ||
        (value != '' && isValidHttpsUrl(value, 2048));
    }

    function isValidFirestoreDocumentId(value) {
      return value is string &&
        value.size() >= 1 &&
        value.size() <= 1500 &&
        value != '.' &&
        value != '..' &&
        !value.matches('.*[/].*') &&
        !value.matches('^__.*__$');
    }

    function isValidChefGalleryItem(value) {
      return value is map &&
        value.keys().size() == 2 &&
        value.keys().hasAll(['name', 'image_url']) &&
        value.name is string &&
        value.name.size() <= 240 &&
        value.image_url != '' &&
        isValidHttpsUrl(value.image_url, 2048);
    }

    // Firestore Rules has no list iteration, so the bounded gallery contract
    // is deliberately unrolled through the product maximum. Six keeps deep
    // item validation comfortably inside the Rules expression budget.
    function isValidChefGallery(value) {
      return value is list &&
        value.size() <= 6 &&
        (value.size() == 0 ||
          (isValidChefGalleryItem(value[0]) &&
            (value.size() == 1 ||
              (isValidChefGalleryItem(value[1]) &&
                (value.size() == 2 ||
                  (isValidChefGalleryItem(value[2]) &&
                    (value.size() == 3 ||
                      (isValidChefGalleryItem(value[3]) &&
                        (value.size() == 4 ||
                          (isValidChefGalleryItem(value[4]) &&
                            (value.size() == 5 ||
                              isValidChefGalleryItem(value[5]))))))))))));
    }
    function isValidBoundedString(value, maxSize) {
      return value is string && value.size() <= maxSize;
    }

    function isValidIdentityProfileStringList0To4(value, maxItemSize) {
      return value.size() == 0 ||
        (value[0] is string &&
          value[0].size() <= maxItemSize &&
          (value.size() == 1 ||
            (value[1] is string &&
              value[1].size() <= maxItemSize &&
              (value.size() == 2 ||
                (value[2] is string &&
                  value[2].size() <= maxItemSize &&
                  (value.size() == 3 ||
                    (value[3] is string &&
                      value[3].size() <= maxItemSize &&
                      (value.size() == 4 ||
                        (value[4] is string &&
                          value[4].size() <= maxItemSize)))))))));
    }

    function isValidIdentityProfileStringList5To9(value, maxItemSize) {
      return value[5] is string &&
        value[5].size() <= maxItemSize &&
        (value.size() == 6 ||
          (value[6] is string &&
            value[6].size() <= maxItemSize &&
            (value.size() == 7 ||
              (value[7] is string &&
                value[7].size() <= maxItemSize &&
                (value.size() == 8 ||
                  (value[8] is string &&
                    value[8].size() <= maxItemSize &&
                    (value.size() == 9 ||
                      (value[9] is string &&
                        value[9].size() <= maxItemSize))))))));
    }

    function isValidIdentityProfileStringList10To14(value, maxItemSize) {
      return value[10] is string &&
        value[10].size() <= maxItemSize &&
        (value.size() == 11 ||
          (value[11] is string &&
            value[11].size() <= maxItemSize &&
            (value.size() == 12 ||
              (value[12] is string &&
                value[12].size() <= maxItemSize &&
                (value.size() == 13 ||
                  (value[13] is string &&
                    value[13].size() <= maxItemSize &&
                    (value.size() == 14 ||
                      (value[14] is string &&
                        value[14].size() <= maxItemSize))))))));
    }

    function isValidIdentityProfileStringList15To19(value, maxItemSize) {
      return value[15] is string &&
        value[15].size() <= maxItemSize &&
        (value.size() == 16 ||
          (value[16] is string &&
            value[16].size() <= maxItemSize &&
            (value.size() == 17 ||
              (value[17] is string &&
                value[17].size() <= maxItemSize &&
                (value.size() == 18 ||
                  (value[18] is string &&
                    value[18].size() <= maxItemSize &&
                    (value.size() == 19 ||
                      (value[19] is string &&
                        value[19].size() <= maxItemSize))))))));
    }

    // Agent and Chef evaluate several required lists in one request. Five-item
    // chunks stop at the actual length; a 20-item list still validates every
    // item against the same type and per-item length contract.
    function isValidIdentityProfileStringList(value, maxItemSize) {
      return value is list &&
        value.size() <= 20 &&
        isValidIdentityProfileStringList0To4(value, maxItemSize) &&
        (value.size() <= 5 ||
          (isValidIdentityProfileStringList5To9(value, maxItemSize) &&
            (value.size() <= 10 ||
              (isValidIdentityProfileStringList10To14(value, maxItemSize) &&
                (value.size() <= 15 ||
                  isValidIdentityProfileStringList15To19(
                    value,
                    maxItemSize
                  ))))));
    }

    function isValidYearValue(value) {
      return value == null ||
        (value is string && value.matches('^[1-9][0-9]{3}$'));
    }

    function isValidExperienceMonth(value) {
      return value in [
        '', 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
        'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'
      ];
    }

    function isValidExperienceYear(value) {
      return value is string &&
        (value == '' || value.matches('^[1-9][0-9]{3}$'));
    }

    function isValidExperienceItem(value) {
      return value is map &&
        value.keys().hasOnly([
          'role',
          'from_month',
          'from_year',
          'to_month',
          'to_year',
          'ongoing',
          'responsibilities',
          'place_id',
          'place_collection'
        ]) &&
        isValidBoundedString(value.role, 160) &&
        isValidExperienceMonth(value.from_month) &&
        isValidExperienceYear(value.from_year) &&
        isValidExperienceMonth(value.to_month) &&
        isValidExperienceYear(value.to_year) &&
        value.ongoing is bool &&
        isValidBoundedString(value.responsibilities, 4000) &&
        isValidFirestoreDocumentId(value.place_id) &&
        value.place_collection in ['', 'kitchens', 'companies'];
    }

    function isValidLanguageItem(value) {
      return value is map &&
        value.keys().hasOnly(['language', 'proficiency']) &&
        value.language is string &&
        value.language.size() >= 1 &&
        value.language.size() <= 120 &&
        isValidBoundedString(value.proficiency, 120);
    }

    function isValidCertificationItem(value) {
      return value is map &&
        value.keys().hasOnly([
          'name',
          'year',
          'place_name',
          'formatted_address',
          'document_url',
          'image_url'
        ]) &&
        isValidBoundedString(value.name, 240) &&
        isValidYearValue(value.year) &&
        isValidBoundedString(value.place_name, 240) &&
        isValidBoundedString(value.formatted_address, 500) &&
        isValidHttpsUrl(value.document_url, 2048) &&
        isValidHttpsUrl(value.image_url, 2048);
    }

    function isValidEducationItem(value) {
      return value is map &&
        value.keys().hasOnly([
          'institution',
          'degree',
          'start_year',
          'end_year',
          'ongoing',
          'formatted_address',
          'document_url',
          'image_url'
        ]) &&
        isValidBoundedString(value.institution, 240) &&
        isValidBoundedString(value.degree, 240) &&
        isValidYearValue(value.start_year) &&
        isValidYearValue(value.end_year) &&
        value.ongoing is bool &&
        isValidBoundedString(value.formatted_address, 500) &&
        isValidHttpsUrl(value.document_url, 2048) &&
        isValidHttpsUrl(value.image_url, 2048);
    }

    function isValidVolunteeringItem(value) {
      return value is map &&
        value.keys().hasOnly([
          'organization',
          'role',
          'from_year',
          'to_year',
          'ongoing',
          'responsibilities'
        ]) &&
        isValidBoundedString(value.organization, 240) &&
        isValidBoundedString(value.role, 160) &&
        isValidYearValue(value.from_year) &&
        isValidYearValue(value.to_year) &&
        value.ongoing is bool &&
        isValidBoundedString(value.responsibilities, 4000);
    }

    function isValidProjectItem(value) {
      return value is map &&
        value.keys().hasOnly([
          'name',
          'role',
          'from_year',
          'to_year',
          'ongoing',
          'responsibilities'
        ]) &&
        isValidBoundedString(value.name, 240) &&
        isValidBoundedString(value.role, 160) &&
        isValidYearValue(value.from_year) &&
        isValidYearValue(value.to_year) &&
        value.ongoing is bool &&
        isValidBoundedString(value.responsibilities, 4000);
    }

    // Evaluate only populated Professional slots. Besides avoiding impossible
    // type branches, this makes the 24-item aggregate cap the expression-cost
    // boundary instead of paying for every slot in every independently capped
    // list. Each branch still validates every present item in order.
    function isValidProfessionalStringList(value) {
      return isValidIdentityProfileStringList(value, 240);
    }

    function isValidProfessionalExperienceChunk(value, start) {
      return value.size() <= start ||
        (isValidExperienceItem(value[start]) &&
          (value.size() <= start + 1 ||
            (isValidExperienceItem(value[start + 1]) &&
              (value.size() <= start + 2 ||
                (isValidExperienceItem(value[start + 2]) &&
                  (value.size() <= start + 3 ||
                    isValidExperienceItem(value[start + 3])))))));
    }

    function isValidProfessionalExperienceList(value) {
      return value is list &&
        value.size() <= 12 &&
        isValidProfessionalExperienceChunk(value, 0) &&
        (value.size() <= 4 ||
          (isValidProfessionalExperienceChunk(value, 4) &&
            (value.size() <= 8 ||
              isValidProfessionalExperienceChunk(value, 8))));
    }

    function isValidProfessionalLanguageChunk(value, start) {
      return value.size() <= start ||
        (isValidLanguageItem(value[start]) &&
          (value.size() <= start + 1 ||
            (isValidLanguageItem(value[start + 1]) &&
              (value.size() <= start + 2 ||
                (isValidLanguageItem(value[start + 2]) &&
                  (value.size() <= start + 3 ||
                    isValidLanguageItem(value[start + 3])))))));
    }

    function isValidProfessionalLanguageList(value) {
      return value is list &&
        value.size() <= 12 &&
        isValidProfessionalLanguageChunk(value, 0) &&
        (value.size() <= 4 ||
          (isValidProfessionalLanguageChunk(value, 4) &&
            (value.size() <= 8 ||
              isValidProfessionalLanguageChunk(value, 8))));
    }

    function isValidProfessionalCertificationChunk(value, start) {
      return value.size() <= start ||
        (isValidCertificationItem(value[start]) &&
          (value.size() <= start + 1 ||
            (isValidCertificationItem(value[start + 1]) &&
              (value.size() <= start + 2 ||
                (isValidCertificationItem(value[start + 2]) &&
                  (value.size() <= start + 3 ||
                    isValidCertificationItem(value[start + 3])))))));
    }

    function isValidProfessionalCertificationList(value) {
      return value is list &&
        value.size() <= 8 &&
        isValidProfessionalCertificationChunk(value, 0) &&
        (value.size() <= 4 ||
          isValidProfessionalCertificationChunk(value, 4));
    }

    function isValidProfessionalEducationChunk(value, start) {
      return value.size() <= start ||
        (isValidEducationItem(value[start]) &&
          (value.size() <= start + 1 ||
            (isValidEducationItem(value[start + 1]) &&
              (value.size() <= start + 2 ||
                (isValidEducationItem(value[start + 2]) &&
                  (value.size() <= start + 3 ||
                    isValidEducationItem(value[start + 3])))))));
    }

    function isValidProfessionalEducationList(value) {
      return value is list &&
        value.size() <= 8 &&
        isValidProfessionalEducationChunk(value, 0) &&
        (value.size() <= 4 ||
          isValidProfessionalEducationChunk(value, 4));
    }

    function isValidProfessionalVolunteeringChunk(value, start) {
      return value.size() <= start ||
        (isValidVolunteeringItem(value[start]) &&
          (value.size() <= start + 1 ||
            (isValidVolunteeringItem(value[start + 1]) &&
              (value.size() <= start + 2 ||
                (isValidVolunteeringItem(value[start + 2]) &&
                  (value.size() <= start + 3 ||
                    isValidVolunteeringItem(value[start + 3])))))));
    }

    function isValidProfessionalVolunteeringList(value) {
      return value is list &&
        value.size() <= 8 &&
        isValidProfessionalVolunteeringChunk(value, 0) &&
        (value.size() <= 4 ||
          isValidProfessionalVolunteeringChunk(value, 4));
    }

    function isValidProfessionalProjectChunk(value, start) {
      return value.size() <= start ||
        (isValidProjectItem(value[start]) &&
          (value.size() <= start + 1 ||
            (isValidProjectItem(value[start + 1]) &&
              (value.size() <= start + 2 ||
                (isValidProjectItem(value[start + 2]) &&
                  (value.size() <= start + 3 ||
                    isValidProjectItem(value[start + 3])))))));
    }

    function isValidProfessionalProjectList(value) {
      return value is list &&
        value.size() <= 8 &&
        isValidProfessionalProjectChunk(value, 0) &&
        (value.size() <= 4 ||
          isValidProfessionalProjectChunk(value, 4));
    }

    function validCreatedStamp(value) {
      return value is map &&
        value.keys().hasAll(['at']) &&
        value.keys().hasOnly(['at', 'by', 'app_id']) &&
        value.at is timestamp &&
        (!('by' in value) ||
          (value.by is string && value.by.size() <= 1500)) &&
        (!('app_id' in value) ||
          (value.app_id is string && value.app_id.size() <= 1500));
    }

    function validUpdatedStamp(value) {
      return value is map &&
        value.keys().hasAll(['at']) &&
        value.keys().hasOnly(['at', 'by']) &&
        value.at is timestamp &&
        (!('by' in value) ||
          (value.by is string && value.by.size() <= 1500));
    }

    function isValidKitchenStation(data, kitchenId) {
      return data is map &&
        data.keys().hasAll([
          'kitchen_id', 'name', 'description', 'active', 'sort_order',
          'created', 'updated'
        ]) &&
        data.keys().hasOnly([
          'kitchen_id', 'name', 'description', 'active', 'sort_order',
          'created', 'updated'
        ]) &&
        data.kitchen_id == kitchenId &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.description is string && data.description.size() <= 2000 &&
        data.active is bool &&
        data.sort_order is int && data.sort_order >= 0 && data.sort_order <= 10000 &&
        validCreatedStamp(data.created) &&
        validUpdatedStamp(data.updated);
    }
    function validOwnerUpdateStamp(data, userId) {
      return validUpdatedStamp(data.updated) &&
        data.updated.at == request.time &&
        data.updated.by == userId;
    }

    function appMembershipPath(appId, userId) {
      return /databases/$(database)/documents/apps/$(appId)/users/$(userId);
    }

    function isAppMember(appId) {
      return isAuthenticated() &&
        exists(appMembershipPath(appId, request.auth.uid)) &&
        get(appMembershipPath(appId, request.auth.uid)).data.role in ['admin', 'user', 'dev'];
    }

    function isAppAdmin(appId) {
      return isAuthenticated() &&
        exists(appMembershipPath(appId, request.auth.uid)) &&
        get(appMembershipPath(appId, request.auth.uid)).data.role in ['admin', 'dev'];
    }

    function workspaceRootPath(collectionName, workspaceId) {
      return /databases/$(database)/documents/$(collectionName)/$(workspaceId);
    }

    function workspaceTeamPath(collectionName, workspaceId, userId) {
      return /databases/$(database)/documents/$(collectionName)/$(workspaceId)/team/$(userId);
    }

    function hasValidWorkspaceManagement(data) {
      return data is map &&
        data.keys().hasAll(['management']) &&
        data.management is map &&
        (
          (
            data.management.keys().hasOnly(['mode']) &&
            data.management.mode == 'workspace'
          ) ||
          (
            data.management.keys().hasAll(['mode', 'app_id']) &&
            data.management.keys().hasOnly(['mode', 'app_id']) &&
            data.management.mode == 'app' &&
            isValidFirestoreDocumentId(data.management.app_id)
          )
        );
    }

    function workspaceManagementAppId(data) {
      return data.management.mode == 'workspace'
        ? 'misebox-app'
        : data.management.app_id;
    }

    function canReadWorkspace(collectionName, workspaceId) {
      let rootPath = workspaceRootPath(collectionName, workspaceId);
      let root = get(rootPath);
      let appId = workspaceManagementAppId(root.data);
      let membershipPath = appMembershipPath(appId, request.auth.uid);
      let membership = get(membershipPath);
      let teamPath = workspaceTeamPath(
        collectionName,
        workspaceId,
        request.auth.uid
      );
      let member = get(teamPath);
      return isAuthenticated() &&
        exists(rootPath) &&
        hasValidWorkspaceManagement(root.data) &&
        exists(membershipPath) &&
        (
          membership.data.role in ['admin', 'dev'] ||
          (
            membership.data.role in ['admin', 'user', 'dev'] &&
            exists(teamPath) &&
            member.data.user_id == request.auth.uid &&
            member.data.status == 'active' &&
            member.data.role in ['owner', 'operator', 'member']
          )
        );
    }

    function canOperateWorkspace(collectionName, workspaceId) {
      let rootPath = workspaceRootPath(collectionName, workspaceId);
      let root = get(rootPath);
      let appId = workspaceManagementAppId(root.data);
      let membershipPath = appMembershipPath(appId, request.auth.uid);
      let membership = get(membershipPath);
      let teamPath = workspaceTeamPath(
        collectionName,
        workspaceId,
        request.auth.uid
      );
      let member = get(teamPath);
      return isAuthenticated() &&
        exists(rootPath) &&
        hasValidWorkspaceManagement(root.data) &&
        exists(membershipPath) &&
        (
          membership.data.role in ['admin', 'dev'] ||
          (
            membership.data.role in ['admin', 'user', 'dev'] &&
            exists(teamPath) &&
            member.data.user_id == request.auth.uid &&
            member.data.status == 'active' &&
            member.data.role in ['owner', 'operator']
          )
        );
    }

    // ===============================================================
    // User identity and owner-only account state
    // ===============================================================
    match /user-handles/{handle} {
      // Reservations are server-owned uniqueness locks, never a client API.
      allow read, write: if false;
    }

    match /user-handle-state/{document} {
      // Provisioning readiness is server-owned and not a client capability.
      allow read, write: if false;
    }

    match /security-migrations/{document} {
      // Release prerequisites are Admin SDK evidence, never client state.
      allow read, write: if false;
    }

    match /ingredients/{ingredientId} {
      // The shared Ingredient library is curated and projected by trusted
      // server APIs. Browsers never read or mutate canonical root documents.
      allow get, list, create, update, delete: if false;

      match /{nested=**} {
        allow get, list, create, update, delete: if false;
      }
    }

    function isValidUser(data) {
      return data.keys().hasAll([
          'display_name',
          'avatar',
          'handle'
        ]) &&
        data.keys().hasOnly([
          'display_name',
          'bio',
          'avatar',
          'handle',
          'ping'
        ]) &&
        validRequiredText(data, 'display_name', 1, 120) &&
        validOptionalText(data, 'bio', 280) &&
        isValidUserAvatar(data.avatar) &&
        (!('ping' in data) || data.ping in ['Mark', 'luke', 'john']) &&
        data.handle is string &&
        data.handle.matches('^[a-z0-9][a-z0-9-]{2,29}$');
    }

    function hasValidCanonicalUser(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        isValidUser(
          get(/databases/$(database)/documents/users/$(userId)).data
        );
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isValidUser(resource.data);
      // Directory listing is projected by the trusted User API.
      allow list: if false;
      // The trusted handle endpoint owns consent validation, uniqueness, and
      // atomic User creation through the Admin SDK.
      allow create: if false;
      allow update: if isOwner(userId) &&
        uidNotModified() &&
        isValidUser(request.resource.data) &&
        request.resource.data.handle == resource.data.handle &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'display_name',
          'bio',
          'avatar',
          'ping'
        ]);
      allow delete: if false;

      match /private/account {
        function isValidPreferences(value) {
          return value is map &&
            value.keys().hasAll([
              'language',
              'theme',
              'email_security_alerts',
              'share_usage_analytics'
            ]) &&
            value.keys().hasOnly([
              'language',
              'theme',
              'email_security_alerts',
              'share_usage_analytics'
            ]) &&
            value.language is string &&
            value.language.size() >= 2 &&
            value.language.size() <= 16 &&
            value.theme in ['system', 'light', 'dark'] &&
            value.email_security_alerts is bool &&
            value.share_usage_analytics is bool;
        }

        function isValidTerms(value) {
          return value is map &&
            value.keys().hasAll(['version', 'accepted_at']) &&
            value.keys().hasOnly(['version', 'accepted_at']) &&
            value.version is string &&
            value.version.size() <= 64 &&
            (
              (value.version.size() >= 1 && value.accepted_at is timestamp) ||
              (value.version == '' && value.accepted_at == null)
            );
        }

        function isValidUserPrivate(data) {
          return data.keys().hasAll([
              'email',
              'preferences',
              'terms',
              'created',
              'updated'
            ]) &&
            data.keys().hasOnly([
              'email',
              'preferences',
              'terms',
              'created',
              'updated'
            ]) &&
            data.email is string &&
            data.email.size() <= 320 &&
            isValidPreferences(data.preferences) &&
            isValidTerms(data.terms) &&
            validCreatedStamp(data.created) &&
            validUpdatedStamp(data.updated);
        }

        allow get: if isOwner(userId);
        allow list, create, delete: if false;
        allow update: if isOwner(userId) &&
          isValidUserPrivate(request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'preferences',
            'updated'
          ]) &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.terms == resource.data.terms &&
          request.resource.data.created == resource.data.created &&
          validOwnerUpdateStamp(request.resource.data, userId);
      }

      match /private/targets {
        // Target ids are private server-owned navigation state. Trusted APIs
        // project the referenced public roots after authenticating the owner.
        allow get, list, create, update, delete: if false;
      }

      match /notifications/{notificationId} {
        function isValidNotification(data) {
          return data.keys().hasAll(['message', 'scope', 'created', 'read']) &&
            data.keys().hasOnly(['message', 'scope', 'created', 'read']) &&
            validRequiredText(data, 'message', 1, 1000) &&
            data.scope in ['ecosystem', 'app'] &&
            data.created is map &&
            data.created.keys().hasAll(['at', 'app_id']) &&
            data.created.keys().hasOnly(['at', 'app_id']) &&
            data.created.at is timestamp &&
            data.created.app_id is string &&
            data.created.app_id.size() <= 1500 &&
            data.read is bool;
        }

        allow get: if isOwner(userId) &&
          isValidNotification(resource.data);
        allow list: if isOwner(userId) &&
          request.query.limit <= 50;
        // Producers publish through trusted server pipelines; a browser may
        // acknowledge or dismiss its own notification, but never mint one.
        allow create: if false;
        allow update: if isOwner(userId) &&
          isValidNotification(request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if isOwner(userId);
      }
    }

    // ===============================================================
    // Canonical Ecosystem bootstrap; public reads use server DTOs
    // ===============================================================
    function isValidEcosystem(data) {
      return data.keys().hasAll([
          'id',
          'project_id',
          'name',
          'slug',
          'description',
          'image_url',
          'website_url',
          'status',
          'created',
          'updated'
        ]) &&
        data.keys().hasOnly([
          'id',
          'project_id',
          'name',
          'slug',
          'description',
          'image_url',
          'website_url',
          'status',
          'created',
          'updated'
        ]) &&
        validRequiredText(data, 'id', 3, 80) &&
        validRequiredText(data, 'project_id', 1, 120) &&
        validRequiredText(data, 'name', 1, 120) &&
        validRequiredText(data, 'slug', 3, 80) &&
        validOptionalText(data, 'description', 1000) &&
        validOptionalText(data, 'image_url', 2048) &&
        validOptionalText(data, 'website_url', 2048) &&
        data.status in ['active', 'inactive', 'archived'] &&
        validCreatedStamp(data.created) &&
        validUpdatedStamp(data.updated);
    }

    match /ecosystems/{ecosystemId} {
      allow get: if ecosystemId == 'misebox' && isBootstrapDeveloper();
      allow list: if false;
      allow create: if ecosystemId == 'misebox' &&
        isBootstrapDeveloper() &&
        isValidEcosystem(request.resource.data) &&
        request.resource.data.id == ecosystemId &&
        request.resource.data.project_id == 'misebox' &&
        request.resource.data.slug == ecosystemId &&
        request.resource.data.created.by == 'misebox-app' &&
        request.resource.data.created.app_id == 'misebox-app' &&
        request.resource.data.created.at == request.time &&
        request.resource.data.updated.by == 'misebox-app' &&
        request.resource.data.updated.at == request.time;
      allow update: if ecosystemId == 'misebox' &&
        isBootstrapDeveloper() &&
        isValidEcosystem(request.resource.data) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.project_id == resource.data.project_id &&
        request.resource.data.slug == resource.data.slug &&
        request.resource.data.created == resource.data.created &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'description',
          'image_url',
          'website_url',
          'status',
          'updated'
        ]) &&
        request.resource.data.updated.by == 'misebox-app' &&
        request.resource.data.updated.at == request.time;
      allow delete: if false;
    }

    // ===============================================================
    // Exact Kitchen identity for trusted Workspace targets
    // ===============================================================
    // ===============================================================
    // Canonical App identity; public reads use server DTOs
    // ===============================================================
    function isValidAppSocialLinks(value) {
      return value is map &&
        value.keys().hasOnly([
          'website',
          'twitter',
          'github',
          'linkedin',
          'instagram',
          'facebook',
          'youtube',
          'email'
        ]) &&
        validOptionalText(value, 'website', 2048) &&
        validOptionalText(value, 'twitter', 2048) &&
        validOptionalText(value, 'github', 2048) &&
        validOptionalText(value, 'linkedin', 2048) &&
        validOptionalText(value, 'instagram', 2048) &&
        validOptionalText(value, 'facebook', 2048) &&
        validOptionalText(value, 'youtube', 2048) &&
        validOptionalText(value, 'email', 320);
    }

    function isValidAppMedia(value) {
      return value is map &&
        value.keys().hasOnly([
          'thumbnail_url',
          'logo_url',
          'wordmark_light_url',
          'wordmark_dark_url',
          'cover_url'
        ]) &&
        validOptionalText(value, 'thumbnail_url', 2048) &&
        validOptionalText(value, 'logo_url', 2048) &&
        validOptionalText(value, 'wordmark_light_url', 2048) &&
        validOptionalText(value, 'wordmark_dark_url', 2048) &&
        validOptionalText(value, 'cover_url', 2048);
    }

    function isValidFireuxRepo(value) {
      return value is map &&
        value.keys().hasAll([
          'key',
          'workspace',
          'launch_order',
          'workspace_families',
          'database_id'
        ]) &&
        value.keys().hasOnly([
          'key',
          'workspace',
          'launch_order',
          'workspace_families',
          'database_id'
        ]) &&
        validRequiredText(value, 'key', 1, 120) &&
        validRequiredText(value, 'workspace', 1, 500) &&
        value.launch_order is int &&
        value.launch_order >= 0 &&
        value.launch_order <= 100000 &&
        value.workspace_families is list &&
        value.workspace_families.size() <= 20 &&
        value.workspace_families.hasOnly([
          'blank',
          'kitchen',
          'portfolio',
          'project',
          'property',
          'supplier'
        ]) &&
        validRequiredText(value, 'database_id', 1, 120);
    }

    function isValidApp(data) {
      return data.keys().hasAll([
          'project_id',
          'database_id',
          'slug',
          'status',
          'app_name',
          'app_short_name',
          'role',
          'self_join_enabled',
          'derived',
          'created',
          'updated'
        ]) &&
        data.keys().hasOnly([
          'project_id',
          'ecosystem_id',
          'database_id',
          'slug',
          'status',
          'app_name',
          'app_short_name',
          'role',
          'tagline',
          'description',
          'short_bio',
          'long_bio',
          'social_links',
          'derived',
          'media',
          'fireux_native',
          'fireux_size',
          'fireux_repo',
          'self_join_enabled',
          'moderation_state',
          'ban_reasons',
          'created',
          'updated'
        ]) &&
        validRequiredText(data, 'project_id', 1, 120) &&
        validOptionalText(data, 'ecosystem_id', 120) &&
        validRequiredText(data, 'database_id', 1, 120) &&
        validRequiredText(data, 'slug', 3, 80) &&
        data.status in ['active', 'inactive', 'archived'] &&
        validRequiredText(data, 'app_name', 1, 60) &&
        validRequiredText(data, 'app_short_name', 1, 40) &&
        data.role in ['global', 'tenant', 'standalone', 'ecosystem', 'system'] &&
        validOptionalText(data, 'tagline', 120) &&
        validOptionalText(data, 'description', 500) &&
        validOptionalText(data, 'short_bio', 240) &&
        validOptionalText(data, 'long_bio', 4000) &&
        (!('social_links' in data) || isValidAppSocialLinks(data.social_links)) &&
        data.derived is map &&
        data.derived.keys().hasAll(['user_count']) &&
        data.derived.keys().hasOnly(['user_count']) &&
        data.derived.user_count is int &&
        data.derived.user_count >= 0 &&
        data.derived.user_count <= 10000000 &&
        (!('media' in data) || isValidAppMedia(data.media)) &&
        (!('fireux_native' in data) || data.fireux_native is bool) &&
        (!('fireux_size' in data) || data.fireux_size in ['big', 'small']) &&
        (!('fireux_repo' in data) || isValidFireuxRepo(data.fireux_repo)) &&
        data.self_join_enabled is bool &&
        (!('moderation_state' in data) || data.moderation_state == '') &&
        (!('ban_reasons' in data) ||
          (data.ban_reasons is list && data.ban_reasons.size() == 0)) &&
        validCreatedStamp(data.created) &&
        validUpdatedStamp(data.updated);
    }

    function isValidAppAdminUpdate(data) {
      return validRequiredText(data, 'app_name', 1, 60) &&
        validRequiredText(data, 'app_short_name', 1, 40) &&
        validOptionalText(data, 'tagline', 120) &&
        validOptionalText(data, 'description', 500) &&
        validOptionalText(data, 'short_bio', 240) &&
        validOptionalText(data, 'long_bio', 4000) &&
        (!('social_links' in data) || isValidAppSocialLinks(data.social_links)) &&
        (!('media' in data) || isValidAppMedia(data.media));
    }

    match /apps/{appId} {
      // App directory reads use trusted endpoints. Raw canonical data is
      // available inside the App; bootstrap access is exact, not broad.
      allow get: if isAppMember(appId) ||
        (appId == 'misebox-app' && isBootstrapDeveloper());
      allow list: if false;
      allow create: if isBootstrapDeveloper() &&
        appId == 'misebox-app' &&
        isValidApp(request.resource.data) &&
        request.resource.data.project_id == 'misebox' &&
        request.resource.data.ecosystem_id == 'misebox' &&
        request.resource.data.database_id == 'misebox' &&
        request.resource.data.slug == appId &&
        request.resource.data.status == 'active' &&
        request.resource.data.role == 'global' &&
        request.resource.data.self_join_enabled == true &&
        request.resource.data.derived.user_count == 0 &&
        request.resource.data.created.by == request.auth.uid &&
        request.resource.data.created.at == request.time &&
        request.resource.data.updated.by == request.auth.uid &&
        request.resource.data.updated.at == request.time;
      allow update: if isAppAdmin(appId) &&
        isValidAppAdminUpdate(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'app_name',
          'app_short_name',
          'tagline',
          'description',
          'short_bio',
          'long_bio',
          'social_links',
          'media',
          'updated'
        ]) &&
        request.resource.data.created == resource.data.created &&
        validOwnerUpdateStamp(request.resource.data, request.auth.uid);
      allow delete: if false;
      match /join-requests/{userId} {
        function isValidJoinRequest(data) {
          return data.keys().hasAll(['user_id', 'created']) &&
            data.keys().hasOnly(['user_id', 'created']) &&
            data.user_id == userId &&
            validCreatedStamp(data.created) &&
            data.created.app_id == appId;
        }

        allow get: if isOwner(userId) ||
          (isAppAdmin(appId) && isValidJoinRequest(resource.data));
        allow list: if isAppAdmin(appId);
        allow create, update, delete: if false;
      }

      match /financial-facts/{factId} {
        allow get, list, create, update, delete: if false;
      }

      // AppUser is membership and App governance only. Profile and Workspace
      // capability state live under their own owners.
      match /membership-blocks/{userId} {
        allow get, list, create, update, delete: if false;
      }

      match /users/{userId} {
        function isValidAppUser(data) {
          return data.keys().hasAll([
              'role',
              'subscription',
              'created',
              'updated'
            ]) &&
            data.keys().hasOnly([
              'role',
              'subscription',
              'onboarding_status',
              'created',
              'updated'
            ]) &&
            data.role in ['admin', 'user', 'dev'] &&
            data.subscription in ['free', 'premium', 'business'] &&
            (!('onboarding_status' in data) ||
              data.onboarding_status in [
                'pending',
                'completed',
                'skipped'
            ]) &&
            validCreatedStamp(data.created) &&
            validUpdatedStamp(data.updated);
        }

        allow get: if isOwner(userId) ||
          (isAppAdmin(appId) && isValidAppUser(resource.data));
        allow list: if isAppAdmin(appId) &&
          request.query.limit <= 100 &&
          isValidAppUser(resource.data);
        allow create, update, delete: if false;
      }

      // These App-owned records are trusted-server capabilities. Ignition is
      // represented by a Conversation kind, not another App collection.
      match /events/{eventId} {
        allow get, list, create, update, delete: if false;
      }

      match /conversations/{conversationId} {
        allow get, list, create, update, delete: if false;

        match /{nested=**} {
          allow get, list, create, update, delete: if false;
        }
      }

      match /marketplace-orders/{orderId} {
        allow get, list, create, update, delete: if false;
      }
    }
    match /kitchens/{kitchenId} {
        allow get: if canReadWorkspace('kitchens', kitchenId);
        allow list, create, update, delete: if false;

        match /team/{userId} {
          allow get, list: if canReadWorkspace('kitchens', kitchenId);
          allow create, update, delete: if false;
        }

        match /ingredients/{ingredientId} {
          function isValidKitchenIngredient(data) {
            return data is map &&
              data.keys().hasAll([
                'ingredient_id',
                'created',
                'updated'
              ]) &&
              data.keys().hasOnly([
                'ingredient_id',
                'created',
                'updated'
              ]) &&
              isValidFirestoreDocumentId(data.ingredient_id) &&
              data.ingredient_id == ingredientId &&
              validCreatedStamp(data.created) &&
              data.created.keys().hasAll(['at', 'by', 'app_id']) &&
              data.created.keys().hasOnly(['at', 'by', 'app_id']) &&
              data.created.app_id == workspaceManagementAppId(
                get(workspaceRootPath('kitchens', kitchenId)).data
              ) &&
              validUpdatedStamp(data.updated) &&
              data.updated.keys().hasAll(['at', 'by']) &&
              data.updated.keys().hasOnly(['at', 'by']);
          }

          function hasActiveCanonicalIngredient() {
            return exists(
                /databases/$(database)/documents/ingredients/$(ingredientId)
              ) &&
              get(
                /databases/$(database)/documents/ingredients/$(ingredientId)
              ).data.status == 'active';
          }

          allow get, list: if canReadWorkspace('kitchens', kitchenId);
          allow create: if (canOperateWorkspace('kitchens', kitchenId)) &&
            isValidKitchenIngredient(request.resource.data) &&
            hasActiveCanonicalIngredient() &&
            request.resource.data.created.at == request.time &&
            request.resource.data.created.by == request.auth.uid &&
            request.resource.data.updated.at == request.time &&
            request.resource.data.updated.by == request.auth.uid;
          allow update: if (canOperateWorkspace('kitchens', kitchenId)) &&
            isValidKitchenIngredient(request.resource.data) &&
            hasActiveCanonicalIngredient() &&
            request.resource.data.ingredient_id == resource.data.ingredient_id &&
            request.resource.data.created == resource.data.created &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'updated'
            ]) &&
            request.resource.data.updated.at == request.time &&
            request.resource.data.updated.by == request.auth.uid;
          // Removing a stale selection remains possible after its canonical
          // root is deprecated or merged.
          allow delete: if canOperateWorkspace('kitchens', kitchenId);

          match /{nested=**} {
            allow get, list, create, update, delete: if false;
          }
        }

        match /orders/{orderId} {
          allow get, list: if canOperateWorkspace('kitchens', kitchenId);
          allow create, update, delete: if false;
        }

        match /sales/{saleId} {
          allow get, list: if canOperateWorkspace('kitchens', kitchenId);
          allow create, update, delete: if false;
        }

        match /dishes/{dishId} {
          function isValidDish(data) {
            return data is map &&
              data.keys().size() <= 20 &&
              data.kitchen_id == kitchenId &&
              data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
              data.slug is string && data.slug.size() <= 200 &&
              data.description is string && data.description.size() <= 5000 &&
              data.item_kind in ['food', 'drink'] &&
              data.is_deal is bool &&
              data.is_flagship is bool &&
              data.image is string && data.image.size() <= 2000 &&
              validCreatedStamp(data.created) &&
              validUpdatedStamp(data.updated);
          }

          allow get, list: if canReadWorkspace('kitchens', kitchenId);
          allow create: if (canOperateWorkspace('kitchens', kitchenId)) &&
            isValidDish(request.resource.data) &&
            request.resource.data.created.at == request.time &&
            request.resource.data.created.by == request.auth.uid &&
            request.resource.data.created.app_id == workspaceManagementAppId(
                get(workspaceRootPath('kitchens', kitchenId)).data
              ) &&
            request.resource.data.updated.at == request.time &&
            request.resource.data.updated.by == request.auth.uid;
          allow update: if (canOperateWorkspace('kitchens', kitchenId)) &&
            isValidDish(request.resource.data) &&
            request.resource.data.kitchen_id == resource.data.kitchen_id &&
            request.resource.data.created == resource.data.created &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'slug', 'description', 'updated'
            ]) &&
            request.resource.data.updated.at == request.time &&
            request.resource.data.updated.by == request.auth.uid;
          allow delete: if canOperateWorkspace('kitchens', kitchenId);
        }

        match /recipes/{recipeId} {
          function isValidRecipe(data) {
            return data is map &&
              data.keys().size() <= 20 &&
              data.kitchen_id == kitchenId &&
              data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
              data.slug is string && data.slug.size() <= 200 &&
              data.description is string && data.description.size() <= 10000 &&
              data.source_language is string && data.source_language.size() <= 35 &&
              data.names is map && data.names.size() <= 30 &&
              data.descriptions is map && data.descriptions.size() <= 30 &&
              validCreatedStamp(data.created) &&
              validUpdatedStamp(data.updated);
          }

          allow get, list: if canReadWorkspace('kitchens', kitchenId);
          allow create: if (canOperateWorkspace('kitchens', kitchenId)) &&
            isValidRecipe(request.resource.data) &&
            request.resource.data.created.at == request.time &&
            request.resource.data.created.by == request.auth.uid &&
            request.resource.data.created.app_id == workspaceManagementAppId(
                get(workspaceRootPath('kitchens', kitchenId)).data
              ) &&
            request.resource.data.updated.at == request.time &&
            request.resource.data.updated.by == request.auth.uid;
          allow update: if (canOperateWorkspace('kitchens', kitchenId)) &&
            isValidRecipe(request.resource.data) &&
            request.resource.data.kitchen_id == resource.data.kitchen_id &&
            request.resource.data.created == resource.data.created &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'slug', 'description', 'source_language', 'names',
              'descriptions', 'updated'
            ]) &&
            request.resource.data.updated.at == request.time &&
            request.resource.data.updated.by == request.auth.uid;
          allow delete: if canOperateWorkspace('kitchens', kitchenId);
        }

        match /menus/{menuId} {
          allow get, list: if canReadWorkspace('kitchens', kitchenId);
          allow create, update: if (canOperateWorkspace('kitchens', kitchenId)) &&
            request.resource.data.keys().size() <= 100 &&
            request.resource.data.kitchen_id == kitchenId;
          allow delete: if canOperateWorkspace('kitchens', kitchenId);

          match /sections/{sectionId} {
            function hasValidMenuSectionScope(data) {
              return data is map &&
                data.keys().size() <= 20 &&
                data.kitchen_id == kitchenId &&
                data.menu_id == menuId;
            }

            allow get, list: if canReadWorkspace('kitchens', kitchenId);
            allow create: if (canOperateWorkspace('kitchens', kitchenId)) &&
              hasValidMenuSectionScope(request.resource.data);
            allow update: if (canOperateWorkspace('kitchens', kitchenId)) &&
              hasValidMenuSectionScope(request.resource.data) &&
              request.resource.data.kitchen_id == resource.data.kitchen_id &&
              request.resource.data.menu_id == resource.data.menu_id;
            allow delete: if canOperateWorkspace('kitchens', kitchenId);

            match /items/{itemId} {
              function hasValidMenuItemScope(data) {
                return data is map &&
                  data.keys().size() <= 20 &&
                  data.kitchen_id == kitchenId &&
                  data.menu_id == menuId &&
                  data.section_id == sectionId &&
                  isValidFirestoreDocumentId(data.dish_id) &&
                  exists(
                    /databases/$(database)/documents/kitchens/$(kitchenId)/dishes/$(data.dish_id)
                  );
              }

              allow get, list: if canReadWorkspace('kitchens', kitchenId);
              allow create: if (canOperateWorkspace('kitchens', kitchenId)) &&
                hasValidMenuItemScope(request.resource.data);
              allow update: if (canOperateWorkspace('kitchens', kitchenId)) &&
                hasValidMenuItemScope(request.resource.data) &&
                request.resource.data.kitchen_id == resource.data.kitchen_id &&
                request.resource.data.menu_id == resource.data.menu_id &&
                request.resource.data.section_id == resource.data.section_id &&
                request.resource.data.dish_id == resource.data.dish_id;
              allow delete: if canOperateWorkspace('kitchens', kitchenId);
            }

            match /{nested=**} {
              allow get, list, create, update, delete: if false;
            }
          }

          match /{nested=**} {
            allow get, list, create, update, delete: if false;
          }
        }

        match /integrations/{integrationId} {
          allow get, list, create, update, delete: if false;

          match /{nested=**} {
            allow get, list, create, update, delete: if false;
          }
        }

        match /{childCollection}/{childId} {
          function isGenericKitchenChildCollection() {
            return !(childCollection in [
              'ingredients',
              'integrations',
              'dishes',
              'recipes',
              'prep-items',
              'stations',
              'mise',
              'mise-tasks',
              'menus',
              'orders',
              'private',
              'sales',
              'team',
              'waste-events'
            ]);
          }

          allow get, list: if isGenericKitchenChildCollection() &&
            (canReadWorkspace('kitchens', kitchenId));
          allow create, update: if isGenericKitchenChildCollection() &&
            (canOperateWorkspace('kitchens', kitchenId)) &&
            request.resource.data.keys().size() <= 100;
          allow delete: if isGenericKitchenChildCollection() &&
            (canOperateWorkspace('kitchens', kitchenId));

          match /{nested=**} {
            allow get, list: if isGenericKitchenChildCollection() &&
              (canReadWorkspace('kitchens', kitchenId));
            allow create, update: if isGenericKitchenChildCollection() &&
              (canOperateWorkspace('kitchens', kitchenId)) &&
              request.resource.data.keys().size() <= 100;
            allow delete: if isGenericKitchenChildCollection() &&
              (canOperateWorkspace('kitchens', kitchenId));
          }
        }
      }
    match /kitchens/{kitchenId} {
        function hasKitchenWorkflowParent() {
          return exists(
            /databases/$(database)/documents/kitchens/$(kitchenId)
          );
        }

        match /waste-events/{wasteEventId} {
          function isValidKitchenWasteEvent(data) {
            return data is map &&
              data.keys().hasAll([
                'kitchen_id', 'item_name', 'quantity', 'unit', 'reason',
                'source', 'occurred_at', 'notes', 'created', 'updated'
              ]) &&
              data.keys().hasOnly([
                'kitchen_id', 'item_name', 'quantity', 'unit', 'reason',
                'source', 'occurred_at', 'notes', 'created', 'updated'
              ]) &&
              data.kitchen_id == kitchenId &&
              isValidBoundedString(data.item_name, 300) &&
              data.item_name.size() > 0 &&
              data.quantity is number &&
              data.quantity > 0 && data.quantity <= 1000000 &&
              isValidBoundedString(data.unit, 80) && data.unit.size() > 0 &&
              data.reason in [
                'spoilage', 'preparation', 'overproduction',
                'cooking_error', 'returned', 'other'
              ] &&
              data.source in [
                'storage', 'prep', 'production', 'service',
                'customer_return', 'other'
              ] &&
              data.occurred_at is timestamp &&
              isValidBoundedString(data.notes, 5000) &&
              validCreatedStamp(data.created) &&
              validUpdatedStamp(data.updated);
          }

          allow get, list: if hasKitchenWorkflowParent() &&
            canReadWorkspace('kitchens', kitchenId);
          allow create: if hasKitchenWorkflowParent() &&
            isValidFirestoreDocumentId(wasteEventId) &&
            canOperateWorkspace('kitchens', kitchenId) &&
            isValidKitchenWasteEvent(request.resource.data) &&
            request.resource.data.occurred_at == request.time &&
            request.resource.data.created.at == request.time &&
            request.resource.data.created.by == request.auth.uid &&
            request.resource.data.created.app_id == workspaceManagementAppId(
              get(workspaceRootPath('kitchens', kitchenId)).data
            ) &&
            request.resource.data.updated.at == request.time &&
            request.resource.data.updated.by == request.auth.uid;
          allow update, delete: if false;

          match /{nested=**} {
            allow get, list, create, update, delete: if false;
          }
        }

        match /stations/{stationId} {
          allow get, list: if hasKitchenWorkflowParent() &&
            (canReadWorkspace('kitchens', kitchenId));
          allow create: if hasKitchenWorkflowParent() &&
            isValidFirestoreDocumentId(stationId) &&
            (canOperateWorkspace('kitchens', kitchenId)) &&
            isValidKitchenStation(request.resource.data, kitchenId) &&
            request.resource.data.created.at == request.time &&
            request.resource.data.created.by == request.auth.uid &&
            request.resource.data.created.app_id == workspaceManagementAppId(
              get(workspaceRootPath('kitchens', kitchenId)).data
            ) &&
            request.resource.data.updated.at == request.time &&
            request.resource.data.updated.by == request.auth.uid;
          allow update: if hasKitchenWorkflowParent() &&
            (canOperateWorkspace('kitchens', kitchenId)) &&
            isValidKitchenStation(request.resource.data, kitchenId) &&
            request.resource.data.kitchen_id == resource.data.kitchen_id &&
            request.resource.data.created == resource.data.created &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'description', 'active', 'sort_order', 'updated'
            ]) &&
            request.resource.data.updated.at == request.time &&
            request.resource.data.updated.by == request.auth.uid;
          allow delete: if hasKitchenWorkflowParent() &&
            (canOperateWorkspace('kitchens', kitchenId));
        }

        // Legacy prep-item documents share the old `mise` name but are not
        // workflow tasks. Preserve member reads while closing browser writes
        // until that record family is separately classified and migrated.
        match /mise/{legacyMiseId} {
          allow get, list: if hasKitchenWorkflowParent() &&
            (canReadWorkspace('kitchens', kitchenId));
          allow create, update, delete: if false;

          match /{nested=**} {
            allow get, list, create, update, delete: if false;
          }
        }

        match /prep-items/{prepItemId} {
          function isValidPrepItemUnit(value) {
            return value in ['', 'g', 'ml', 'each', 'portion'];
          }

          function isValidPrepItemInput(value) {
            return value is map &&
              value.keys().hasAll([
                'ingredient_id', 'quantity', 'unit', 'preparation'
              ]) &&
              value.keys().hasOnly([
                'ingredient_id', 'quantity', 'unit', 'preparation'
              ]) &&
              isValidFirestoreDocumentId(value.ingredient_id) &&
              value.quantity is number && value.quantity >= 0 &&
              value.quantity <= 1000000000 &&
              isValidPrepItemUnit(value.unit) && value.unit != '' &&
              isValidBoundedString(value.preparation, 500);
          }

          function isValidPrepItemInputChunk(value, start) {
            return value.size() <= start ||
              (isValidPrepItemInput(value[start]) &&
                (value.size() <= start + 1 ||
                  (isValidPrepItemInput(value[start + 1]) &&
                    (value.size() <= start + 2 ||
                      (isValidPrepItemInput(value[start + 2]) &&
                        (value.size() <= start + 3 ||
                          isValidPrepItemInput(value[start + 3])))))));
          }

          function isValidPrepItemInputs(value) {
            return value is list && value.size() <= 12 &&
              isValidPrepItemInputChunk(value, 0) &&
              (value.size() <= 4 ||
                (isValidPrepItemInputChunk(value, 4) &&
                  (value.size() <= 8 ||
                    isValidPrepItemInputChunk(value, 8))));
          }

          function isValidPrepItemMethodChunk(value, start) {
            return value.size() <= start ||
              (isValidBoundedString(value[start], 1000) &&
                value[start].size() > 0 &&
                (value.size() <= start + 1 ||
                  (isValidBoundedString(value[start + 1], 1000) &&
                    value[start + 1].size() > 0 &&
                    (value.size() <= start + 2 ||
                      (isValidBoundedString(value[start + 2], 1000) &&
                        value[start + 2].size() > 0 &&
                        (value.size() <= start + 3 ||
                          (isValidBoundedString(value[start + 3], 1000) &&
                            value[start + 3].size() > 0)))))));
          }

          function isValidPrepItemMethod(value) {
            return value is list && value.size() <= 20 &&
              isValidPrepItemMethodChunk(value, 0) &&
              (value.size() <= 4 ||
                (isValidPrepItemMethodChunk(value, 4) &&
                  (value.size() <= 8 ||
                    (isValidPrepItemMethodChunk(value, 8) &&
                      (value.size() <= 12 ||
                        (isValidPrepItemMethodChunk(value, 12) &&
                          (value.size() <= 16 ||
                            isValidPrepItemMethodChunk(value, 16))))))));
          }

          function isValidKitchenPrepItem(data) {
            return data is map &&
              data.keys().hasAll([
                'kitchen_id', 'name', 'slug', 'description',
                'source_language', 'names', 'descriptions', 'station',
                'inputs', 'recipe_id', 'yield', 'method', 'created', 'updated'
              ]) &&
              data.keys().hasOnly([
                'kitchen_id', 'name', 'slug', 'description',
                'source_language', 'names', 'descriptions', 'station',
                'inputs', 'recipe_id', 'yield', 'method', 'created', 'updated'
              ]) &&
              data.kitchen_id == kitchenId &&
              isValidBoundedString(data.name, 240) && data.name.size() > 0 &&
              isValidBoundedString(data.slug, 240) && data.slug.size() > 0 &&
              isValidBoundedString(data.description, 10000) &&
              isValidBoundedString(data.source_language, 35) &&
              data.source_language.size() > 0 &&
              data.names is map && data.names.size() <= 30 &&
              data.descriptions is map && data.descriptions.size() <= 30 &&
              isValidBoundedString(data.station, 200) &&
              isValidPrepItemInputs(data.inputs) &&
              isValidBoundedString(data.recipe_id, 1500) &&
              (data.recipe_id == '' || isValidFirestoreDocumentId(data.recipe_id)) &&
              data.yield is map &&
              data.yield.keys().hasAll(['quantity', 'unit']) &&
              data.yield.keys().hasOnly(['quantity', 'unit']) &&
              data.yield.quantity is number && data.yield.quantity >= 0 &&
              data.yield.quantity <= 1000000000 &&
              isValidPrepItemUnit(data.yield.unit) &&
              isValidPrepItemMethod(data.method) &&
              validCreatedStamp(data.created) &&
              validUpdatedStamp(data.updated);
          }

          allow get, list: if hasKitchenWorkflowParent() &&
            (canReadWorkspace('kitchens', kitchenId));
          allow create: if hasKitchenWorkflowParent() &&
            isValidFirestoreDocumentId(prepItemId) &&
            (canOperateWorkspace('kitchens', kitchenId)) &&
            isValidKitchenPrepItem(request.resource.data) &&
            request.resource.data.created.at == request.time &&
            request.resource.data.created.by == request.auth.uid &&
            request.resource.data.created.app_id == workspaceManagementAppId(
              get(workspaceRootPath('kitchens', kitchenId)).data
            ) &&
            request.resource.data.updated.at == request.time &&
            request.resource.data.updated.by == request.auth.uid;
          allow update: if hasKitchenWorkflowParent() &&
            (canOperateWorkspace('kitchens', kitchenId)) &&
            isValidKitchenPrepItem(request.resource.data) &&
            request.resource.data.kitchen_id == resource.data.kitchen_id &&
            request.resource.data.created == resource.data.created &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'slug', 'description', 'source_language', 'names',
              'descriptions', 'station', 'inputs', 'recipe_id', 'yield',
              'method', 'updated'
            ]) &&
            request.resource.data.updated.at == request.time &&
            request.resource.data.updated.by == request.auth.uid;
          allow delete: if hasKitchenWorkflowParent() &&
            (canOperateWorkspace('kitchens', kitchenId));

          match /{nested=**} {
            allow get, list, create, update, delete: if false;
          }
        }

        match /mise-tasks/{taskId} {
          function isMiseTimestampOrUnset(value) {
            return value is timestamp || (value is map && value.size() == 0);
          }

          function isValidMiseChecklistItem(value) {
            return value is map &&
              value.keys().hasAll(['id', 'label', 'done']) &&
              value.keys().hasOnly(['id', 'label', 'done']) &&
              isValidBoundedString(value.id, 200) && value.id.size() > 0 &&
              isValidBoundedString(value.label, 500) && value.label.size() > 0 &&
              value.done is bool;
          }

          function isValidMiseChecklistChunk(value, start) {
            return value.size() <= start ||
              (isValidMiseChecklistItem(value[start]) &&
                (value.size() <= start + 1 ||
                  (isValidMiseChecklistItem(value[start + 1]) &&
                    (value.size() <= start + 2 ||
                      (isValidMiseChecklistItem(value[start + 2]) &&
                        (value.size() <= start + 3 ||
                          isValidMiseChecklistItem(value[start + 3])))))));
          }

          function isValidMiseChecklist(value) {
            return value is list && value.size() <= 20 &&
              isValidMiseChecklistChunk(value, 0) &&
              (value.size() <= 4 ||
                (isValidMiseChecklistChunk(value, 4) &&
                  (value.size() <= 8 ||
                    (isValidMiseChecklistChunk(value, 8) &&
                      (value.size() <= 12 ||
                        (isValidMiseChecklistChunk(value, 12) &&
                          (value.size() <= 16 ||
                            isValidMiseChecklistChunk(value, 16))))))));
          }

          function isValidKitchenMiseTask(data) {
            return data is map &&
              data.keys().hasAll([
                'kitchen_id', 'title', 'description', 'station',
                'service_date', 'status', 'priority', 'estimated_minutes',
                'ingredient_ids', 'prep_item_ids', 'menu_id', 'recipe_id',
                'assignee_ids', 'checklist', 'due_at', 'completed_at',
                'notes', 'created', 'updated'
              ]) &&
              data.keys().hasOnly([
                'kitchen_id', 'title', 'description', 'station',
                'workflow_stage', 'service_date', 'status', 'priority',
                'estimated_minutes', 'ingredient_ids', 'prep_item_ids', 'menu_id',
                'recipe_id', 'assignee_ids', 'checklist', 'due_at',
                'completed_at', 'notes', 'created', 'updated'
              ]) &&
              data.kitchen_id == kitchenId &&
              isValidBoundedString(data.title, 240) && data.title.size() > 0 &&
              isValidBoundedString(data.description, 5000) &&
              isValidBoundedString(data.station, 200) &&
              (!('workflow_stage' in data) || data.workflow_stage in [
                '', 'wash', 'cut_portion', 'make', 'cook_chill',
                'set_stations', 'final_checks'
              ]) &&
              data.service_date is string &&
              (data.service_date == '' ||
                data.service_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) &&
              data.status in ['todo', 'in_progress', 'done', 'blocked'] &&
              data.priority in ['low', 'normal', 'high', 'urgent'] &&
              data.estimated_minutes is int &&
              data.estimated_minutes >= 0 && data.estimated_minutes <= 10080 &&
              isValidIdentityProfileStringList(data.ingredient_ids, 1500) &&
              isValidIdentityProfileStringList(data.prep_item_ids, 1500) &&
              isValidBoundedString(data.menu_id, 1500) &&
              isValidBoundedString(data.recipe_id, 1500) &&
              isValidIdentityProfileStringList(data.assignee_ids, 1500) &&
              isValidMiseChecklist(data.checklist) &&
              isMiseTimestampOrUnset(data.due_at) &&
              isMiseTimestampOrUnset(data.completed_at) &&
              isValidBoundedString(data.notes, 10000) &&
              validCreatedStamp(data.created) &&
              validUpdatedStamp(data.updated);
          }

          allow get, list: if hasKitchenWorkflowParent() &&
            (canReadWorkspace('kitchens', kitchenId));
          allow create: if hasKitchenWorkflowParent() &&
            isValidFirestoreDocumentId(taskId) &&
            (canOperateWorkspace('kitchens', kitchenId)) &&
            request.resource.data.keys().hasAll(['workflow_stage']) &&
            isValidKitchenMiseTask(request.resource.data) &&
            request.resource.data.created.at == request.time &&
            request.resource.data.created.by == request.auth.uid &&
            request.resource.data.created.app_id == workspaceManagementAppId(
              get(workspaceRootPath('kitchens', kitchenId)).data
            ) &&
            request.resource.data.updated.at == request.time &&
            request.resource.data.updated.by == request.auth.uid;
          allow update: if hasKitchenWorkflowParent() &&
            (canOperateWorkspace('kitchens', kitchenId)) &&
            isValidKitchenMiseTask(request.resource.data) &&
            request.resource.data.kitchen_id == resource.data.kitchen_id &&
            request.resource.data.created == resource.data.created &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'title', 'description', 'station', 'workflow_stage',
              'service_date', 'status', 'priority', 'estimated_minutes',
              'ingredient_ids', 'prep_item_ids', 'menu_id', 'recipe_id',
              'assignee_ids', 'checklist', 'due_at', 'completed_at',
              'notes', 'updated'
            ]) &&
            request.resource.data.updated.at == request.time &&
            request.resource.data.updated.by == request.auth.uid;
          allow delete: if hasKitchenWorkflowParent() &&
            (canOperateWorkspace('kitchens', kitchenId));
        }
      }
    match /suppliers/{supplierId} {
      allow get: if canReadWorkspace('suppliers', supplierId);
      allow list, create, update, delete: if false;

      match /team/{userId} {
        allow get, list: if canReadWorkspace('suppliers', supplierId);
        allow create, update, delete: if false;
      }

      // Supplier owns its Catalogue, Ingredients, and Items operations. Their
      // concrete records remain domain-shaped while authority stays on Team.
      match /{operationCollection}/{recordId} {
        function isSupplierOperation() {
          return operationCollection in [
            'catalogue',
            'ingredients',
            'items'
          ];
        }

        allow get, list: if isSupplierOperation() &&
          (canReadWorkspace('suppliers', supplierId));
        allow create, update: if isSupplierOperation() &&
          (canOperateWorkspace('suppliers', supplierId)) &&
          request.resource.data.keys().size() <= 100;
        allow delete: if isSupplierOperation() &&
          (canOperateWorkspace('suppliers', supplierId));

        match /{nested=**} {
          allow get, list: if isSupplierOperation() &&
            (canReadWorkspace('suppliers', supplierId));
          allow create, update: if isSupplierOperation() &&
            (canOperateWorkspace('suppliers', supplierId)) &&
            request.resource.data.keys().size() <= 100;
          allow delete: if isSupplierOperation() &&
            (canOperateWorkspace('suppliers', supplierId));
        }
      }
    }
    match /marketplace-stores/{storeId} {
      // Marketplace identity, Team, Offers, and Orders use trusted domain
      // endpoints. Root ownership is explicit even while browser access stays
      // closed.
      allow get, list, create, update, delete: if false;

      match /team/{userId} {
        allow get, list, create, update, delete: if false;
      }

      match /offers/{offerId} {
        allow get, list, create, update, delete: if false;
      }

      match /{nested=**} {
        allow get, list, create, update, delete: if false;
      }
    }
    // Place detail subscriptions exact-read known canonical Place ids. Index
    // and search remain server-owned, and every browser write remains denied.
    match /places/{placeId} {
      allow get: if resource != null;
      allow list, create, update, delete: if false;
    }
    match /users/{userId}/profiles/customer {
      function isValidCustomerPrivate(value) {
        return value is map &&
          value.keys().hasAll([
            'name',
            'phone',
            'allergy_note',
            'default_delivery_address',
            'saved_addresses',
            'order_history'
          ]) &&
          value.keys().hasOnly([
            'name',
            'phone',
            'allergy_note',
            'default_delivery_address',
            'saved_addresses',
            'order_history'
          ]) &&
          value.name is string && value.name.size() <= 120 &&
          value.phone is string && value.phone.size() <= 40 &&
          value.allergy_note is string && value.allergy_note.size() <= 1000 &&
          value.default_delivery_address is string &&
          value.default_delivery_address.size() <= 500 &&
          value.saved_addresses is list && value.saved_addresses.size() <= 20 &&
          value.order_history is list && value.order_history.size() <= 200;
      }

      function isValidCustomerProfile(data) {
        return data.keys().hasAll(['kind', 'created', 'updated']) &&
          data.keys().hasOnly(['kind', 'private', 'created', 'updated']) &&
          data.kind == 'customer' &&
          (!('private' in data) || isValidCustomerPrivate(data.private)) &&
          validCreatedStamp(data.created) &&
          validUpdatedStamp(data.updated);
      }

      function validCustomerSelfChange() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'private',
            'updated'
          ]) &&
          (
            ('private' in resource.data &&
              request.resource.data.private.diff(resource.data.private)
                .affectedKeys().hasOnly([
                  'name',
                  'phone',
                  'allergy_note',
                  'default_delivery_address'
                ])) ||
            (!('private' in resource.data) &&
              request.resource.data.private.saved_addresses.size() == 0 &&
              request.resource.data.private.order_history.size() == 0)
          );
      }

      allow get: if isOwner(userId) && isValidCustomerProfile(resource.data);
      allow list, create, delete: if false;
      allow update: if isOwner(userId) &&
        isValidCustomerProfile(request.resource.data) &&
        request.resource.data.created == resource.data.created &&
        validCustomerSelfChange() &&
        validOwnerUpdateStamp(request.resource.data, userId);
    }
    // ===============================================================
    // Driver capability
    // ===============================================================
    function isValidDriverProfile(data) {
      return data.keys().hasAll([
          'kind',
          'title',
          'subtitle',
          'tagline',
          'tags',
          'coverage',
          'created',
          'updated'
        ]) &&
        data.keys().hasOnly([
          'kind',
          'title',
          'subtitle',
          'tagline',
          'tags',
          'coverage',
          'created',
          'updated'
        ]) &&
        data.kind == 'driver' &&
        data.title is string && data.title.size() <= 120 &&
        data.subtitle is string && data.subtitle.size() <= 240 &&
        data.tagline is string && data.tagline.size() <= 240 &&
        data.tags is list &&
        data.tags.size() <= 20 &&
        data.tags.hasOnly([
          'available',
          'courier',
          'delivery',
          'driver',
          'exclusive',
          'preferred'
        ]) &&
        data.coverage is map &&
        data.coverage.keys().hasAll(['radius_m']) &&
        data.coverage.keys().hasOnly(['radius_m']) &&
        data.coverage.radius_m is int &&
        data.coverage.radius_m >= 0 &&
        data.coverage.radius_m <= 200000 &&
        validCreatedStamp(data.created) &&
        validUpdatedStamp(data.updated);
    }

    match /users/{userId}/profiles/driver {
      allow get: if isOwner(userId) ||
        (isValidDriverProfile(resource.data) &&
          hasValidCanonicalUser(userId));
      // Driver directory listing is projected by the trusted Driver API.
      allow list: if false;
      // Trusted profile provisioning creates the root profile document.
      allow create: if false;
      allow update: if isOwner(userId) &&
        isValidDriverProfile(request.resource.data) &&
        request.resource.data.created == resource.data.created &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'subtitle',
          'tagline',
          'tags',
          'coverage',
          'updated'
        ]) &&
        request.resource.data.updated.at == request.time &&
        request.resource.data.updated.by == userId;
      allow delete: if false;
    }

    match /users/{userId}/profiles/driver/app-state/{appId} {
      function isValidDriverAppState(data) {
        return data.keys().hasAll([
            'profile_kind', 'app_id', 'driver_phone',
            'accepts_weak_pings', 'accepts_delivery_tenders',
            'active_kitchen_ids', 'kitchen_links', 'created', 'updated'
          ]) &&
          data.keys().hasOnly([
            'profile_kind', 'app_id', 'driver_phone',
            'accepts_weak_pings', 'accepts_delivery_tenders',
            'active_kitchen_ids', 'kitchen_links', 'created', 'updated'
          ]) &&
          data.profile_kind == 'driver' &&
          data.app_id == appId &&
          validOptionalText(data, 'driver_phone', 40) &&
          data.accepts_weak_pings is bool &&
          data.accepts_delivery_tenders is bool &&
          validOptionalList(data, 'active_kitchen_ids', 50) &&
          validOptionalList(data, 'kitchen_links', 50) &&
          validCreatedStamp(data.created) &&
          data.created.app_id == appId &&
          validUpdatedStamp(data.updated);
      }

      allow get: if isOwner(userId) && isAppMember(appId) &&
        isValidDriverAppState(resource.data);
      allow list, create, delete: if false;
      allow update: if isOwner(userId) &&
        isAppMember(appId) &&
        isValidDriverAppState(request.resource.data) &&
        request.resource.data.created == resource.data.created &&
        request.resource.data.profile_kind == resource.data.profile_kind &&
        request.resource.data.app_id == resource.data.app_id &&
        request.resource.data.active_kitchen_ids == resource.data.active_kitchen_ids &&
        request.resource.data.kitchen_links == resource.data.kitchen_links &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'driver_phone',
          'accepts_weak_pings',
          'accepts_delivery_tenders',
          'updated'
        ]) &&
        validOwnerUpdateStamp(request.resource.data, userId);
    }
    // ===============================================================
    // Other identity profiles
    // ===============================================================
    function validProfileStamp(data) {
      return validCreatedStamp(data.created) &&
        validUpdatedStamp(data.updated);
    }

    function validProfileOwnerWrite(data, userId) {
      // The family validator already validates the full stamp shape. Keep this
      // helper to the request-time owner transition so the schema is not
      // evaluated repeatedly in the same Rules request.
      return data.updated.at == request.time &&
        data.updated.by == userId;
    }

    function isValidChef(data) {
      return data.keys().size() == 11 &&
        data.keys().hasAll([
          'kind',
          'title',
          'summary',
          'chef_bio',
          'chef_image',
          'chef_signature_dishes',
          'chef_gallery',
          'kitchen_ids',
          'chef_organization_name',
          'created',
          'updated'
        ]) &&
        data.kind == 'chef' &&
        isValidBoundedString(data.title, 120) &&
        isValidBoundedString(data.summary, 1000) &&
        isValidBoundedString(data.chef_bio, 4000) &&
        isValidHttpsUrl(data.chef_image, 2048) &&
        isValidBoundedString(data.chef_organization_name, 160) &&
        isValidIdentityProfileStringList(data.chef_signature_dishes, 240) &&
        isValidChefGallery(data.chef_gallery) &&
        isValidIdentityProfileStringList(data.kitchen_ids, 1500) &&
        validCreatedStamp(data.created) &&
        validUpdatedStamp(data.updated);
    }

    function isValidAgent(data) {
      return data.keys().size() == 15 &&
        data.keys().hasAll([
          'kind',
          'title',
          'summary',
          'agent_bio',
          'agent_image',
          'agent_placement_types',
          'agent_coverage_areas',
          'agent_contact_email',
          'agent_contact_phone',
          'agent_website_url',
          'subtitle',
          'tagline',
          'tags',
          'created',
          'updated'
        ]) &&
        data.kind == 'agent' &&
        isValidBoundedString(data.title, 120) &&
        isValidBoundedString(data.summary, 1000) &&
        isValidBoundedString(data.agent_bio, 4000) &&
        isValidHttpsUrl(data.agent_image, 2048) &&
        isValidBoundedString(data.agent_contact_email, 320) &&
        isValidBoundedString(data.agent_contact_phone, 40) &&
        isValidHttpsUrl(data.agent_website_url, 2048) &&
        isValidBoundedString(data.subtitle, 240) &&
        isValidBoundedString(data.tagline, 240) &&
        isValidIdentityProfileStringList(data.agent_placement_types, 240) &&
        isValidIdentityProfileStringList(data.agent_coverage_areas, 240) &&
        isValidIdentityProfileStringList(data.tags, 240) &&
        validCreatedStamp(data.created) &&
        validUpdatedStamp(data.updated);
    }

    function isValidProfessional(data) {
      return data.keys().size() == 18 &&
        data.keys().hasOnly([
          'kind',
          'title',
          'subtitle',
          'tagline',
          'summary',
          'bio',
          'image',
          'positions',
          'tags',
          'relevant_experience',
          'other_experience',
          'languages',
          'certifications',
          'education',
          'volunteering',
          'projects',
          'created',
          'updated'
        ]) &&
        data.kind == 'professional' &&
        isValidBoundedString(data.title, 120) &&
        isValidBoundedString(data.subtitle, 240) &&
        isValidBoundedString(data.tagline, 240) &&
        isValidBoundedString(data.summary, 1000) &&
        isValidBoundedString(data.bio, 4000) &&
        isValidHttpsUrl(data.image, 2048) &&
        data.positions is list &&
        data.positions.size() <= 20 &&
        data.tags is list &&
        data.tags.size() <= 20 &&
        data.relevant_experience is list &&
        data.relevant_experience.size() <= 12 &&
        data.other_experience is list &&
        data.other_experience.size() <= 12 &&
        data.languages is list &&
        data.languages.size() <= 12 &&
        data.certifications is list &&
        data.certifications.size() <= 8 &&
        data.education is list &&
        data.education.size() <= 8 &&
        data.volunteering is list &&
        data.volunteering.size() <= 8 &&
        data.projects is list &&
        data.projects.size() <= 8 &&
        data.relevant_experience.size() +
          data.other_experience.size() +
          data.languages.size() +
          data.certifications.size() +
          data.education.size() +
          data.volunteering.size() +
          data.projects.size() <= 24 &&
        validProfileStamp(data);
    }

    function changesAtMostOneProfessionalStructuredFamily(changed) {
      return (!changed.hasAny(['relevant_experience']) ||
          !changed.hasAny([
            'other_experience',
            'languages',
            'certifications',
            'education',
            'volunteering',
            'projects'
          ])) &&
        (!changed.hasAny(['other_experience']) ||
          !changed.hasAny([
            'languages',
            'certifications',
            'education',
            'volunteering',
            'projects'
          ])) &&
        (!changed.hasAny(['languages']) ||
          !changed.hasAny([
            'certifications',
            'education',
            'volunteering',
            'projects'
          ])) &&
        (!changed.hasAny(['certifications']) ||
          !changed.hasAny(['education', 'volunteering', 'projects'])) &&
        (!changed.hasAny(['education']) ||
          !changed.hasAny(['volunteering', 'projects'])) &&
        (!changed.hasAny(['volunteering']) ||
          !changed.hasAny(['projects']));
    }

    function isValidChangedProfessionalLists(data, changed) {
      return (!changed.hasAny(['positions']) ||
          isValidProfessionalStringList(data.positions)) &&
        (!changed.hasAny(['tags']) ||
          isValidProfessionalStringList(data.tags)) &&
        (!changed.hasAny(['relevant_experience']) ||
          isValidProfessionalExperienceList(data.relevant_experience)) &&
        (!changed.hasAny(['other_experience']) ||
          isValidProfessionalExperienceList(data.other_experience)) &&
        (!changed.hasAny(['languages']) ||
          isValidProfessionalLanguageList(data.languages)) &&
        (!changed.hasAny(['certifications']) ||
          isValidProfessionalCertificationList(data.certifications)) &&
        (!changed.hasAny(['education']) ||
          isValidProfessionalEducationList(data.education)) &&
        (!changed.hasAny(['volunteering']) ||
          isValidProfessionalVolunteeringList(data.volunteering)) &&
        (!changed.hasAny(['projects']) ||
          isValidProfessionalProjectList(data.projects));
    }

    function isValidProfessionalOwnerUpdate(data, userId) {
      let changed = data.diff(resource.data).affectedKeys();
      return isValidProfessional(data) &&
        data.created == resource.data.created &&
        changed.hasOnly([
          'title',
          'subtitle',
          'tagline',
          'summary',
          'bio',
          'image',
          'positions',
          'tags',
          'relevant_experience',
          'other_experience',
          'languages',
          'certifications',
          'education',
          'volunteering',
          'projects',
          'updated'
        ]) &&
        changesAtMostOneProfessionalStructuredFamily(changed) &&
        isValidChangedProfessionalLists(data, changed) &&
        validProfileOwnerWrite(data, userId);
    }

    match /users/{userId}/profiles/chef {
      // Chef directory and detail reads use trusted Entity APIs.
      allow get: if isOwner(userId);
      allow list: if false;
      // Trusted profile provisioning creates the root and updates
      // Profile document existence is the capability index.
      allow create: if false;
      allow update: if isOwner(userId) &&
        isValidChef(request.resource.data) &&
        request.resource.data.created == resource.data.created &&
        validProfileOwnerWrite(request.resource.data, userId);
      allow delete: if false;
    }

    match /users/{userId}/profiles/agent {
      // Agent directory and detail reads use trusted Entity APIs.
      allow get: if isOwner(userId);
      allow list: if false;
      // Trusted profile provisioning creates the root and updates
      // Profile document existence is the capability index.
      allow create: if false;
      allow update: if isOwner(userId) &&
        isValidAgent(request.resource.data) &&
        request.resource.data.created == resource.data.created &&
        validProfileOwnerWrite(request.resource.data, userId);
      allow delete: if false;
    }

    match /users/{userId}/profiles/professional {
      // Professional directory and detail reads use trusted Entity APIs.
      allow get: if isOwner(userId);
      allow list: if false;
      // Trusted profile provisioning creates the root and updates
      // Profile document existence is the capability index.
      allow create: if false;
      allow update: if isOwner(userId) &&
        isValidProfessionalOwnerUpdate(request.resource.data, userId);
      allow delete: if false;
    }

    // ===============================================================
    // All remaining collections are denied by default. Domain reads require
    // an explicit reviewed rule or a server-owned reader.
  }
}
