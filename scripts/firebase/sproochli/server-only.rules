rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /menu_translation_caches/{document=**} {
      allow read, write: if false;
    }

    match /translation_memory/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
