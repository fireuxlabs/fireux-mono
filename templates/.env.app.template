# FireUX App environment
# App identity and branding belong in nuxt.config.ts and app.config.ts.

# Deployment origin
APP_DOMAIN=

# Firebase Web App (per App; API key may use the Ecosystem default)
NUXT_FIREBASE_API_KEY=
NUXT_FIREBASE_APP_ID=

# Optional authenticated developer UID; this is not a PIN or password.
DEVELOPER_ID=
