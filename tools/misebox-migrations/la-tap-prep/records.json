    {
      "id": "bread-aioli",
      "name": "Bread-based aioli",
      "output_preparation_id": "aioli",
      "description": "Aioli made with bread, garlic, lemon and olive oil.",
      "yield": {
        "quantity": 4,
        "unit": "portions"
      },
      "inputs": [
        {
          "kind": "ingredient",
          "reference_id": "white-bread",
          "quantity": 2,
          "unit": "slices"
        },
        {
          "kind": "ingredient",
          "reference_id": "lemon",
          "quantity": 1,
          "unit": "each"
        },
        {
          "kind": "ingredient",
          "reference_id": "garlic",
          "quantity": 2,
          "unit": "cloves"
        },
        {
          "kind": "ingredient",
          "reference_id": "olive-oil",
          "quantity": 200,
          "unit": "ml"
        }
      ],
      "method": [
        "Hydrate the bread, then squeeze out excess water.",
        "Blend it with garlic and the lemon zest and juice.",
        "Feed in the oil gradually to form the sauce; adjust seasoning."
      ],
      "source": {
        "title": "Richard Corrigan · Great British Chefs",
        "url": "https://www.greatbritishchefs.com/recipes/aioli-recipe"
      }
    },
    {
      "id": "saffron-aioli",
      "name": "Saffron aioli",
