{
  "name": "fireux-toolbar",
  "displayName": "FireUX Toolbar",
  "publisher": "fire-uxxx",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fireuxToolbar.catTree",
        "title": "Cat Tree (Terminal)",
        "icon": "$(list-tree)"
      },
      {
        "command": "fireuxToolbar.catTreeToEditor",
        "title": "Cat Tree (Editor)",
        "icon": "$(output)"
      },
      {
        "command": "fireuxToolbar.startFireux",
        "title": "Dev: FireUX",
        "icon": "$(flame)"
      },
      {
        "command": "fireuxToolbar.startMisebox",
        "title": "Dev: MiseBox",
        "icon": "$(book)"
      },
      {
        "command": "fireuxToolbar.startCleanbox",
        "title": "Dev: CleanBox",
        "icon": "$(beaker)"
      },
      {
        "command": "fireuxToolbar.startNiederhorn",
        "title": "Dev: Niederhorn",
        "icon": "$(mountain)"
      },
      {
        "command": "fireuxToolbar.startRichies",
        "title": "Dev: Richies",
        "icon": "$(tools)"
      },
      {
        "command": "fireuxToolbar.startTenant",
        "title": "Dev: Tenant",
        "icon": "$(home)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "fireuxToolbar.catTree",
          "group": "navigation@8",
          "when": "resourceScheme == 'file'"
        },
        {
          "command": "fireuxToolbar.catTreeToEditor",
          "group": "navigation@9",
          "when": "resourceScheme == 'file'"
        }
      ],
      "commandCenter": [
        {
          "command": "fireuxToolbar.startFireux",
          "group": "navigation@1",
          "when": "true"
        },
        {
          "command": "fireuxToolbar.startMisebox",
          "group": "navigation@2",
          "when": "true"
        },
        {
          "command": "fireuxToolbar.startCleanbox",
          "group": "navigation@3",
          "when": "true"
        },
        {
          "command": "fireuxToolbar.startNiederhorn",
          "group": "navigation@4",
          "when": "true"
        },
        {
          "command": "fireuxToolbar.startRichies",
          "group": "navigation@5",
          "when": "true"
        },
        {
          "command": "fireuxToolbar.startTenant",
          "group": "navigation@6",
          "when": "true"
        }
      ],
      "editor/title": [
        {
          "command": "fireuxToolbar.startFireux",
          "group": "navigation@1",
          "when": "true"
        },
        {
          "command": "fireuxToolbar.startMisebox",
          "group": "navigation@2",
          "when": "true"
        },
        {
          "command": "fireuxToolbar.startCleanbox",
          "group": "navigation@3",
          "when": "true"
        },
        {
          "command": "fireuxToolbar.startNiederhorn",
          "group": "navigation@4",
          "when": "true"
        },
        {
          "command": "fireuxToolbar.startRichies",
          "group": "navigation@5",
          "when": "true"
        },
        {
          "command": "fireuxToolbar.startTenant",
          "group": "navigation@6",
          "when": "true"
        }
      ],
      "statusBar": [
        {
          "command": "fireuxToolbar.startFireux",
          "group": "navigation@1",
          "when": "true"
        },
        {
          "command": "fireuxToolbar.startMisebox",
          "group": "navigation@2",
          "when": "true"
        },
        {
          "command": "fireuxToolbar.startCleanbox",
          "group": "navigation@3",
          "when": "true"
        },
        {
          "command": "fireuxToolbar.startNiederhorn",
          "group": "navigation@4",
          "when": "true"
        },
        {
          "command": "fireuxToolbar.startRichies",
          "group": "navigation@5",
          "when": "true"
        },
        {
          "command": "fireuxToolbar.startTenant",
          "group": "navigation@6",
          "when": "true"
        }
      ]
    },
    "keybindings": [
      {
        "command": "fireuxToolbar.startFireux",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "workspaceFolderCount > 0"
      },
      {
        "command": "fireuxToolbar.startMisebox",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "workspaceFolderCount > 0"
      },
      {
        "command": "fireuxToolbar.startCleanbox",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "workspaceFolderCount > 0"
      }
    ],
    "configuration": {
      "title": "FireUX Toolbar",
      "properties": {
        "fireuxToolbar.reuseBrowserTab": {
          "type": "boolean",
          "default": true,
          "description": "On macOS, try to focus an existing browser tab for the target dev server instead of always opening a new one (falls back to normal openExternal if unsupported)."
        },
        "fireuxToolbar.reuseBrowser": {
          "type": "string",
          "enum": ["chrome", "safari", "default"],
          "default": "chrome",
          "description": "Which browser to target for tab reuse on macOS. 'default' disables the special reuse logic and uses VS Code openExternal."
        },
        "fireuxToolbar.reuseMatch": {
          "type": "string",
          "enum": ["origin", "exact"],
          "default": "origin",
          "description": "How to match an existing tab: 'origin' matches host+port (recommended), 'exact' matches the full URL string."
        }
      }
    },
    "configurationDefaults": {
      "window.commandCenter": true
    }
  }
}
