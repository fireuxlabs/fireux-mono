{
  "name": "fireux-toolbar",
  "displayName": "FireUX Toolbar",
  "publisher": "fire-uxxx",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fireuxToolbar.openServersView",
        "title": "Open FireUX Servers",
        "icon": "$(server-process)",
        "category": "FireUX"
      },
      {
        "command": "fireuxToolbar.startAllServers",
        "title": "Start All FireUX Servers",
        "icon": "$(run-all)",
        "category": "FireUX"
      },
      {
        "command": "fireuxToolbar.refreshServers",
        "title": "Refresh FireUX Servers",
        "icon": "$(refresh)",
        "category": "FireUX"
      },
      {
        "command": "fireuxToolbar.startAppByKey",
        "title": "Start FireUX App",
        "icon": "$(debug-start)",
        "category": "FireUX"
      },
      {
        "command": "fireuxToolbar.openAppByKey",
        "title": "Open FireUX App URL",
        "icon": "$(globe)",
        "category": "FireUX"
      },
      {
        "command": "fireuxToolbar.killAppByKey",
        "title": "Kill FireUX App Dev Server",
        "icon": "$(debug-stop)",
        "category": "FireUX"
      },
      {
        "command": "fireuxToolbar.catTree",
        "title": "Cat Tree (Terminal)",
        "icon": "$(list-tree)"
      },
      {
        "command": "fireuxToolbar.catTreeToEditor",
        "title": "Cat Tree (Editor)",
        "icon": "$(output)"
      },
      {
        "command": "fireuxToolbar.mirrorTreeToEditor",
        "title": "Mirror Tree (Editor)",
        "icon": "$(list-tree)"
      },
      {
        "command": "fireuxToolbar.startFireux",
        "title": "Dev: FireUX",
        "icon": "$(flame)"
      },
      {
        "command": "fireuxToolbar.startMisebox",
        "title": "Dev: MiseBox",
        "icon": "$(book)"
      },
      {
        "command": "fireuxToolbar.startWerkbox",
        "title": "Dev: Werkbox",
        "icon": "$(beaker)"
      },
      {
        "command": "fireuxToolbar.startRichies",
        "title": "Dev: Richies",
        "icon": "$(tools)"
      },
      {
        "command": "fireuxToolbar.startTenant",
        "title": "Dev: Tenant",
        "icon": "$(home)"
      },
      {
        "command": "fireuxToolbar.startBringli",
        "title": "Dev: Bringli",
        "icon": "$(symbol-namespace)"
      },
      {
        "command": "fireuxToolbar.startGranite",
        "title": "Dev: Granite",
        "icon": "$(database)"
      },
      {
        "command": "fireuxToolbar.startBuenoHost",
        "title": "Dev: BuenoHost",
        "icon": "$(key)"
      },
      {
        "command": "fireuxToolbar.mirrorSync",
        "title": "Mirror Sync",
        "icon": "$(files)",
        "category": "FireUX"
      },
      {
        "command": "fireuxToolbar.mirrorFromGitQ",
        "title": "Mirror (Git Q)",
        "icon": "$(files)",
        "category": "FireUX"
      },
      {
        "command": "fireuxToolbar.gitTree",
        "title": "Git Tree",
        "icon": "$(list-tree)",
        "category": "FireUX"
      },
      {
        "command": "fireuxToolbar.gitQPreview",
        "title": "Git Q Preview",
        "icon": "$(git-commit)",
        "category": "FireUX"
      },
      {
        "command": "fireuxToolbar.gitSave",
        "title": "Git Save",
        "icon": "$(cloud-upload)",
        "category": "FireUX"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fireux-fireux",
          "title": "FireUX",
          "icon": "media/fireux.svg"
        },
        {
          "id": "fireux-buenohost",
          "title": "BuenoHost",
          "icon": "media/buenohost.svg"
        },
        {
          "id": "fireux-misebox",
          "title": "Misebox",
          "icon": "media/misebox.svg"
        },
        {
          "id": "fireux-werkbox",
          "title": "Werkbox",
          "icon": "media/werkbox.svg"
        },
        {
          "id": "fireux-bringli",
          "title": "Bringli",
          "icon": "media/bringli.svg"
        },
        {
          "id": "fireux-granite",
          "title": "Granite",
          "icon": "media/granite.svg"
        },
        {
          "id": "fireux-slap",
          "title": "Slap",
          "icon": "media/slap.svg"
        }
      ]
    },
    "views": {
      "fireux-fireux": [
        {
          "id": "fireuxToolbar.fireuxServersView",
          "name": "FireUX Apps"
        }
      ],
      "fireux-buenohost": [
        {
          "id": "fireuxToolbar.buenohostServersView",
          "name": "BuenoHost Apps"
        }
      ],
      "fireux-misebox": [
        {
          "id": "fireuxToolbar.miseboxServersView",
          "name": "Misebox Apps"
        }
      ],
      "fireux-werkbox": [
        {
          "id": "fireuxToolbar.werkboxServersView",
          "name": "Werkbox Apps"
        }
      ],
      "fireux-bringli": [
        {
          "id": "fireuxToolbar.bringliServersView",
          "name": "Bringli Apps"
        }
      ],
      "fireux-granite": [
        {
          "id": "fireuxToolbar.graniteServersView",
          "name": "Granite Apps"
        }
      ],
      "fireux-slap": [
        {
          "id": "fireuxToolbar.slapServersView",
          "name": "Slap Apps"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "fireuxToolbar.catTree",
          "group": "navigation@8",
          "when": "resourceScheme == 'file'"
        },
        {
          "command": "fireuxToolbar.catTreeToEditor",
          "group": "navigation@9",
          "when": "resourceScheme == 'file'"
        },
        {
          "command": "fireuxToolbar.mirrorTreeToEditor",
          "group": "navigation@10",
          "when": "resourceScheme == 'file' && explorerResourceIsFolder && resourceFilename == 'mirror'"
        }
      ],
      "commandCenter": [
        {
          "command": "fireuxToolbar.startFireux",
          "group": "navigation@1",
          "when": "true"
        },
        {
          "command": "fireuxToolbar.startMisebox",
          "group": "navigation@2",
          "when": "true"
        },
        {
          "command": "fireuxToolbar.gitSave",
          "group": "navigation@3",
          "when": "true"
        }
      ],
      "editor/title": [
        {
          "command": "fireuxToolbar.startFireux",
          "group": "navigation@1",
          "when": "true"
        },
        {
          "command": "fireuxToolbar.startMisebox",
          "group": "navigation@2",
          "when": "true"
        },
        {
          "command": "fireuxToolbar.gitSave",
          "group": "navigation@3",
          "when": "true"
        }
      ],
      "view/title": [
        {
          "command": "fireuxToolbar.startAllServers",
          "group": "navigation@1",
          "when": "view =~ /fireuxToolbar\\..*ServersView/"
        },
        {
          "command": "fireuxToolbar.refreshServers",
          "group": "navigation@2",
          "when": "view =~ /fireuxToolbar\\..*ServersView/"
        }
      ],
      "view/item/context": [
        {
          "command": "fireuxToolbar.startAppByKey",
          "group": "inline@1",
          "when": "view =~ /fireuxToolbar\\..*ServersView/ && viewItem == fireuxServer"
        },
        {
          "command": "fireuxToolbar.openAppByKey",
          "group": "inline@2",
          "when": "view =~ /fireuxToolbar\\..*ServersView/ && viewItem == fireuxServer"
        },
        {
          "command": "fireuxToolbar.killAppByKey",
          "group": "inline@3",
          "when": "view =~ /fireuxToolbar\\..*ServersView/ && viewItem == fireuxServer"
        }
      ]
    },
    "keybindings": [
      {
        "command": "fireuxToolbar.startFireux",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "workspaceFolderCount > 0"
      },
      {
        "command": "fireuxToolbar.startMisebox",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "workspaceFolderCount > 0"
      },
      {
        "command": "fireuxToolbar.startWerkbox",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "workspaceFolderCount > 0"
      }
    ],
    "configuration": {
      "title": "FireUX Toolbar",
      "properties": {
        "fireuxToolbar.reuseBrowserTab": {
          "type": "boolean",
          "default": true,
          "description": "On macOS, try to focus an existing browser tab for the target dev server instead of always opening a new one (falls back to normal openExternal if unsupported)."
        },
        "fireuxToolbar.reuseBrowser": {
          "type": "string",
          "enum": [
            "chrome",
            "safari",
            "default"
          ],
          "default": "chrome",
          "description": "Which browser to target for tab reuse on macOS. 'default' disables the special reuse logic and uses VS Code openExternal."
        },
        "fireuxToolbar.reuseMatch": {
          "type": "string",
          "enum": [
            "origin",
            "exact"
          ],
          "default": "origin",
          "description": "How to match an existing tab: 'origin' matches host+port (recommended), 'exact' matches the full URL string."
        }
      }
    },
    "configurationDefaults": {
      "window.commandCenter": true
    }
  }
}
