{
  "compilerOptions": {
    "baseUrl": ".",
    "typeRoots": ["./types", "./node_modules/@types"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "strict": true,
    "plugins": [{ "name": "@vue/typescript-plugin" }],
    "paths": {
      "vite/client": ["types/vite/client.d.ts"],
      "fireux-core": ["packages/core/fireux-core/src/module.ts"],
      "fireux-core/*": ["packages/core/fireux-core/src/*"],
      "fireux-core/runtime/*": ["packages/core/fireux-core/src/runtime/*"],
      "fireux-jobs": ["packages/extensions/fireux-jobs/src/module.ts"],
      "fireux-jobs/*": ["packages/extensions/fireux-jobs/src/*"],
      "fireux-jobs/runtime/*": [
        "packages/extensions/fireux-jobs/src/runtime/*"
      ],
      "#fireux-jobs-models/*": [
        "packages/extensions/fireux-jobs/src/runtime/models/*"
      ],
      "fireux-places": ["packages/extensions/fireux-places/src/module.ts"],
      "fireux-places/*": ["packages/extensions/fireux-places/src/*"],
      "fireux-places/runtime/*": [
        "packages/extensions/fireux-places/src/runtime/*"
      ],
      "#fireux-places-models/*": [
        "packages/extensions/fireux-places/src/runtime/models/*"
      ],
      "fireux-misebox": ["packages/ecosystem/fireux-misebox/src/module.ts"],
      "fireux-misebox/*": ["packages/ecosystem/fireux-misebox/src/*"],
      "fireux-cleanbox": ["packages/ecosystem/fireux-cleanbox/src/module.ts"],
      "fireux-cleanbox/*": ["packages/ecosystem/fireux-cleanbox/src/*"],
      "fireux-fireux": ["packages/ecosystem/fireux-fireux/src/module.ts"],
      "fireux-fireux/*": ["packages/ecosystem/fireux-fireux/src/*"],
      "@fireux-core/*": ["packages/core/fireux-core/src/*"],
      "@fireux-jobs/*": ["packages/extensions/fireux-jobs/src/*"],
      "@fireux-places/*": ["packages/extensions/fireux-places/src/*"],
      "@fireux-misebox/*": ["packages/ecosystem/fireux-misebox/src/*"],
      "@fireux-cleanbox/*": ["packages/ecosystem/fireux-cleanbox/src/*"],
      "@fireux-fireux/*": ["packages/ecosystem/fireux-fireux/src/*"],
      "#fireux-blogs/*": ["packages/extensions/fireux-blogs/src/runtime/*"],
      "#fireux-products/*": ["packages/extensions/fireux-products/src/runtime/*"],
      "#fireux-drop/*": ["packages/extensions/fireux-drop/src/runtime/*"],
      "#fireux-ecosystem-controller/*": [
        "packages/core/fireux-ecosystem-controller/src/runtime/*"
      ],
      "#fireux-core-models/*": ["packages/core/fireux-core/src/runtime/models/*"],
      "#fireux-core-runtime/*": ["packages/core/fireux-core/src/runtime/*"],
      "#fireux-core-composables/*": [
        "packages/core/fireux-core/src/runtime/composables/*"
      ],
      "#fireux-cleanbox-models/*": [
        "packages/ecosystem/fireux-cleanbox/src/runtime/models/*"
      ],
      "#fireux-misebox-models/*": [
        "packages/ecosystem/fireux-misebox/src/runtime/models/*"
      ],
      "#fireux-fireux-models/*": [
        "packages/ecosystem/fireux-fireux/src/runtime/models/*"
      ],
      "~/*": [
        "projects/fireux/fireux-app/app/*",
        "projects/fireux/tennant/app/*",
        "projects/misebox/misebox-app/app/*",
        "projects/misebox/niederhorn/app/*",
        "projects/cleanbox/cleanbox-app/app/*",
        "projects/cleanbox/richies-reinigung/app/*"
      ],
      "@/*": [
        "projects/fireux/fireux-app/app/*",
        "projects/fireux/tennant/app/*",
        "projects/misebox/misebox-app/app/*",
        "projects/misebox/niederhorn/app/*",
        "projects/cleanbox/cleanbox-app/app/*",
        "projects/cleanbox/richies-reinigung/app/*"
      ],
      "~~/*": [
        "projects/fireux/fireux-app/*",
        "projects/fireux/tennant/*",
        "projects/misebox/misebox-app/*",
        "projects/misebox/niederhorn/*",
        "projects/cleanbox/cleanbox-app/*",
        "projects/cleanbox/richies-reinigung/*"
      ],
      "@@/*": [
        "projects/fireux/fireux-app/*",
        "projects/fireux/tennant/*",
        "projects/misebox/misebox-app/*",
        "projects/misebox/niederhorn/*",
        "projects/cleanbox/cleanbox-app/*",
        "projects/cleanbox/richies-reinigung/*"
      ],
      "#imports": ["types/nuxt-shims.d.ts"],
      "#pwa": ["types/pwa.d.ts"],
      "vuefire/server": ["types/vuefire-server.d.ts"]
    }
  }
}
